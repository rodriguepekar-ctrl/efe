{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efe.example.com/schemas/efe-meta-swarm-loadgen/profile-v1.json",
  "title": "EFE Meta-Swarm Loadgen — Workload Profile Schema v1",
  "description": "PR #20 § 18 + § 35 + STABILITY_CONTRACT v1.2 § 10.4. Versioned schema for the workload profile YAML consumed by `efe-meta-swarm-loadgen --profile <file>`. Frozen for ≥ 6 chart-minor versions ; future shape changes bump to version: 2.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "target"],
  "properties": {
    "version": {
      "const": 1,
      "description": "Schema discriminator.  Currently only `1` is supported.  AD11 / AD25."
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1,
      "maxLength": 64,
      "description": "Human-readable identifier ; matches kubernetes naming conventions."
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoints"],
      "properties": {
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url"],
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^grpc(s)?://[^@]+:[0-9]+$",
                "description": "gRPC URL.  `grpc://` (plaintext) or `grpcs://` (TLS)."
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0.0,
                "maximum": 1.0,
                "default": 1.0
              }
            }
          }
        },
        "role": {
          "enum": ["controller", "participant"],
          "default": "controller"
        },
        "conns_per_target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 4
        },
        "per_request_deadline": {
          "$ref": "#/$defs/duration"
        },
        "mtls": {
          "$ref": "#/$defs/mtls"
        }
      }
    },
    "pattern": {
      "oneOf": [
        { "$ref": "#/$defs/pattern_constant" },
        { "$ref": "#/$defs/pattern_ramp" },
        { "$ref": "#/$defs/pattern_burst" },
        { "$ref": "#/$defs/pattern_diurnal" },
        { "$ref": "#/$defs/pattern_replay" }
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["iterate", "step", "reset", "state", "mixed"]
        },
        "mix": {
          "$ref": "#/$defs/workload_mix"
        },
        "initial_state": {
          "enum": ["random", "zero", "from-file"]
        },
        "initial_state_dim": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "max_iters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_wall_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    },
    "rate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["open", "closed", "hybrid"],
          "default": "hybrid"
        },
        "max_concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 200
        },
        "overflow_policy": {
          "enum": ["drop", "block"],
          "default": "drop"
        }
      }
    },
    "termination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration": { "$ref": "#/$defs/duration" },
        "requests": {
          "type": "integer",
          "minimum": 1
        },
        "until_slo": {
          "type": "object",
          "additionalProperties": { "type": "number" },
          "properties": {
            "iterate-availability": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            },
            "iterate-latency-p95": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 60.0
            },
            "iterate-latency-p99": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 60.0
            },
            "manifest-reload-latency-p95": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 60.0
            },
            "otel-drop-rate": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          }
        },
        "convergence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tolerance", "consecutive_iterations"],
          "properties": {
            "tolerance": {
              "type": "number",
              "exclusiveMinimum": 0.0,
              "maximum": 1.0
            },
            "consecutive_iterations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format"],
      "properties": {
        "format": {
          "enum": ["terminal", "json", "csv", "ndjson", "parquet"]
        },
        "file": {
          "type": "string",
          "pattern": "^(/|\\./|\\$)"
        },
        "record": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "listen": {
              "type": "string",
              "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|\\*|0\\.0\\.0\\.0):[0-9]+$"
            }
          }
        },
        "otel": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "endpoint": {
              "type": "string",
              "format": "uri"
            },
            "sampler_arg": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0,
              "default": 1.0
            },
            "service_name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "log": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "enum": ["text", "json"] },
            "level": { "enum": ["trace", "debug", "info", "warn", "error"] }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "mode": {
          "enum": ["dev", "staging", "production"],
          "default": "dev"
        },
        "allow_mutation": {
          "type": "boolean",
          "default": false
        },
        "chaos_marker": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(s|m|h|ms|us|ns|d)$",
      "description": "humantime-parseable duration (e.g., `5m`, `30s`, `500ms`)."
    },
    "mtls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cert_path", "key_path", "ca_path"],
      "properties": {
        "cert_path": {
          "type": "string",
          "description": "Client certificate (PEM, chain). Matches PR #16 layout."
        },
        "key_path": {
          "type": "string",
          "description": "Client private key (PEM, PKCS-8 ECDSA-P256 preferred)."
        },
        "ca_path": {
          "type": "string",
          "description": "CA bundle (PEM)."
        },
        "expected_san": {
          "type": "string",
          "description": "Expected server SAN (DNS or URI form)."
        }
      }
    },
    "workload_mix": {
      "type": "object",
      "additionalProperties": false,
      "description": "Weights MUST sum to 1.0 (tolerance 1e-3 — engine enforces).",
      "properties": {
        "iterate": { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0 },
        "step":    { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0 },
        "reset":   { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0 },
        "state":   { "type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.0 }
      }
    },
    "pattern_constant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "qps"],
      "properties": {
        "type": { "const": "constant" },
        "qps": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 100000.0,
          "description": "Hard cap 100 000 — AD5."
        },
        "ramp_up": { "$ref": "#/$defs/duration" }
      }
    },
    "pattern_ramp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "initial_qps", "final_qps", "duration"],
      "properties": {
        "type": { "const": "ramp" },
        "initial_qps": { "type": "number", "minimum": 0.0, "maximum": 100000.0 },
        "final_qps":   { "type": "number", "minimum": 0.0, "maximum": 100000.0 },
        "shape": { "enum": ["linear", "exponential"], "default": "linear" },
        "duration": { "$ref": "#/$defs/duration" },
        "ramp_up":  { "$ref": "#/$defs/duration" }
      }
    },
    "pattern_burst": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "baseline_qps", "burst_qps", "burst_duration", "burst_interval"],
      "properties": {
        "type": { "const": "burst" },
        "baseline_qps":   { "type": "number", "minimum": 0.0, "maximum": 100000.0 },
        "burst_qps":      { "type": "number", "minimum": 0.0, "maximum": 100000.0 },
        "burst_duration": { "$ref": "#/$defs/duration" },
        "burst_interval": { "$ref": "#/$defs/duration" },
        "ramp_up":        { "$ref": "#/$defs/duration" }
      }
    },
    "pattern_diurnal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "daily_min_qps", "daily_max_qps", "period"],
      "properties": {
        "type": { "const": "diurnal" },
        "daily_min_qps": { "type": "number", "minimum": 0.0, "maximum": 100000.0 },
        "daily_max_qps": { "type": "number", "minimum": 0.0, "maximum": 100000.0 },
        "period": { "$ref": "#/$defs/duration" },
        "phase":  { "$ref": "#/$defs/duration" },
        "ramp_up":{ "$ref": "#/$defs/duration" }
      }
    },
    "pattern_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "file"],
      "properties": {
        "type": { "const": "replay" },
        "file": { "type": "string" },
        "mode": { "enum": ["preserve-spacing", "accelerate", "drain"], "default": "preserve-spacing" },
        "speed": { "type": "number", "minimum": 0.001, "maximum": 1000.0, "default": 1.0 }
      }
    }
  }
}

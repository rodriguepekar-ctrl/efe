#!/usr/bin/env bash
# scripts/benches.list — Sprint D5 source of truth for ALL EFE benches.
#
# Schema per row (colon-separated, exactly 7 fields, no spaces around colons):
#
#   name:crate:sprint:blas-aware:tier:slo-prefix:paths-watch
#
# Fields:
# ─────────────────────────────────────────────────────────────────────
# 1. name           — matches the [[bench]] name in Cargo.toml.
#                     `cargo bench --bench <name>` must work.
# 2. crate          — "efe-core" or "efe-server" (only these two
#                     have benches today; other crates would extend
#                     this list).
# 3. sprint         — Free text identifier of the originating sprint
#                     (C, S2, S3, S4, D1, D2, D3, D4). Used by the
#                     SPRINT= filter. Comma-separated lists supported
#                     downstream (e.g., SPRINT=D1,D4).
# 4. blas-aware     — "blas" if `--features accelerate` / `openblas`
#                     changes behaviour ; "no-blas" otherwise. Drives
#                     whether the runner forwards $BLAS_BACKEND to
#                     the cargo invocation for this bench.
# 5. tier           — "default" : run on every PR by default.
#                     "micro"   : run only when explicitly requested
#                                 (TIER=micro or TIER=all).
#                     The split exists because micro benches have no
#                     SLO gate and produce ~6 sub-benches each ; we
#                     don't want them stretching the default CI path
#                     until they're calibrated and gated.
# 6. slo-prefix     — Space-separated list of group-name prefixes used
#                     by parse_criterion_report.py to walk the criterion
#                     JSON. Empty for benches with no SLO (heap
#                     profilers, micro). Multiple prefixes allowed
#                     (e.g., "real_e2e_ real_phase_" for benches that
#                     emit several group families).
# 7. paths-watch    — Space-separated globs that trigger this bench in
#                     CI path filtering. The bench.yml `paths:` filter
#                     is generated by `regen_bench_yml_paths.sh` from
#                     the union of these globs (plus a fixed set of
#                     scaffolding paths).
#
# Conventions:
# ─────────────────────────────────────────────────────────────────────
# - Fields containing spaces (slo-prefix, paths-watch) are NOT quoted
#   — bash IFS=':' splits on colons only, preserving inner spaces.
# - Lines starting with `#` and blank lines are comments / spacing.
# - Entries are alphabetically sorted by `name` within each crate
#   block, and the crate blocks are ordered efe-core then efe-server.
# - When adding a new bench:
#   1. Add a [[bench]] target to the relevant Cargo.toml.
#   2. Add ONE line here.
#   3. Run `scripts/check_benches_list.sh` to validate.
#   4. Run `scripts/regen_bench_yml_paths.sh` to refresh the workflow.
#   5. The CI matrix (bench-core-* / bench-server) routes by sprint
#      automatically — no additional changes needed unless the new
#      bench introduces a sprint not yet listed in the matrix block
#      mapping (cf. bench.yml comments).

# shellcheck disable=SC2034  # array consumed via run_bench_catalog by sourcing scripts.
declare -a EFE_BENCHES=(
  # --- efe-core ---
  "compute_pipeline:efe-core:D3:blas:default:compute_pipeline_:crates/efe-core/src/compute/** crates/efe-core/src/fusion/kernels/**"
  "compute_sprint2:efe-core:S2:no-blas:micro::crates/efe-core/src/compute/cpu/**"
  "compute_sprint3:efe-core:S3:no-blas:micro::crates/efe-core/src/compute/cpu/**"
  "compute_sprint4:efe-core:S4:blas:micro::crates/efe-core/src/compute/cpu/linalg**"
  "memory_e2e:efe-core:C:no-blas:default:memory_e2e_:crates/efe-core/src/memory/**"
  "memory_real_arena:efe-core:D2:no-blas:default:pool_acquire_ arena_alloc_ arena_reset realistic_swarm_alloc_pattern:crates/efe-core/src/memory/**"
  "swarm_e2e:efe-core:C:no-blas:default:swarm_e2e_:crates/efe-core/src/swarm/**"

  # --- efe-meta-swarm (Sprint A1 Phase 1 — PR #4) ---
  # The bench emits BOTH a standard criterion estimates tree
  # (consumed by parse_criterion_report.py for the LATENCY-P50 /
  # LATENCY-P99 SLOs) AND a sidecar JSON file at
  #   target/criterion/three_swarms_kovant_latency/meta-swarm-extras.json
  # carrying the 5 algorithmic + operational SLO values (iters,
  # residual, determinism, memory, regression).  The slo-prefix below
  # captures the criterion group prefix used by the latency
  # measurements ; the sidecar is wired through `--eval-bench-format`
  # in the bench workflow (cf. PR #4 architecture document § 4.2).
  # See bench_baselines/v0.10.0/meta_swarm_slos.yaml for the 7 SLO
  # definitions.
  "three_swarms_kovant_latency:efe-meta-swarm:A1:no-blas:default:three_swarms_kovant_latency_:crates/efe-meta-swarm/benches/** crates/efe-meta-swarm/src/** crates/efe-meta-swarm/Cargo.toml bench_baselines/v0.10.0/**"

  # --- efe-server ---
  "real_memory:efe-server:D1:no-blas:default:real_memory_:crates/efe-server/src/mode1.rs"
  "real_strategies_e2e:efe-server:D1:blas:default:real_e2e_ real_phase_:crates/efe-server/src/mode1.rs crates/efe-server/src/services/**"
  "server_rpc:efe-server:D4:blas:default:server_rpc_:crates/efe-server/src/services/** crates/efe-server/src/bridge/** crates/efe-server/src/interceptors/**"
)

# ─────────────────────────────────────────────────────────────────────
# Helper: iterate the catalog, calling `$1 <7 fields…>` per row.
#
# Used by:
#   - bench_runner.sh   → filtering and execution.
#   - check_benches_list.sh → lint validation.
#   - regen_bench_yml_paths.sh → path filter generation.
#
# Callers source this file then invoke `run_bench_catalog <fn>`.
# ─────────────────────────────────────────────────────────────────────
run_bench_catalog() {
  local cb="$1"
  if [ -z "$cb" ]; then
    echo "run_bench_catalog: callback function name required" >&2
    return 2
  fi
  local row name crate sprint blas tier slo paths
  for row in "${EFE_BENCHES[@]}"; do
    # Split on colons. The 7th field captures everything after the
    # 6th colon, which preserves any internal space characters in
    # `paths-watch` (multiple paths in one row).
    IFS=':' read -r name crate sprint blas tier slo paths <<< "$row"
    "$cb" "$name" "$crate" "$sprint" "$blas" "$tier" "$slo" "$paths"
  done
}

# EFE PoC — configuration UNIQUE (sourcée par ./poc.sh)
# ─────────────────────────────────────────────────────────────────────────
# Un seul fichier configure les 6 processus (bridge + UI + 4 SLM). poc.sh
# traduit ces POC_* vers les variables EFE_* que le bridge + les scripts SLM
# comprennent déjà. Format = KEY=value (shell-sourceable).
#
# PRIORITÉ : env ambiant > poc.env > défaut. La forme `${VAR:-valeur}` ci-dessous
# garantit qu'une variable déjà exportée dans ton shell l'emporte sur le fichier
# (ex. `POC_BRIDGE_ADDR=127.0.0.1:8788 ./poc.sh up` pour changer de port). Les
# flags CLI de poc.sh (--real, --no-ui, --no-slm) surchargent encore au-dessus.
# ─────────────────────────────────────────────────────────────────────────

# Mode de démo :
#   keyless → LLM mock (déterministe, GRATUIT) + SLM réels = "la pépite"
#   real    → vrais providers (Claude/GPT/Gemini), clés en env (jamais ici)
POC_MODE="${POC_MODE:-keyless}"

# Adresse du bridge (sert l'UI + l'API). localhost = pas d'exposition réseau.
POC_BRIDGE_ADDR="${POC_BRIDGE_ADDR:-127.0.0.1:8700}"

# Pré-mâchage SLM réel (1 = les 4 llama-server tournent ; 0 = simulé par le moteur).
POC_LIVE_SLM="${POC_LIVE_SLM:-1}"

# Build + sert l'UI (export statique Next.js) via le bridge (1) ; 0 = API seule.
POC_BUILD_UI="${POC_BUILD_UI:-1}"

# Build release du bridge (1 = plus rapide à l'exécution ; 0 = build dev rapide).
POC_RELEASE="${POC_RELEASE:-1}"

# Origine CORS autorisée (utile seulement si l'UI est servie depuis le dev-server
# Next.js sur :3000 ; sans objet quand le bridge sert l'UI en same-origin).
POC_CORS_ORIGIN="${POC_CORS_ORIGIN:-http://localhost:3000}"

# Bearer token du bridge (vide = pas d'auth, démo locale). Si défini, l'UI doit
# fournir NEXT_PUBLIC_EFE_PREVIEW_TOKEN au build.
POC_TOKEN="${POC_TOKEN:-}"

# Chemin du rapport savings servi par GET /v1/savings-report (vide = défaut interne).
POC_SAVINGS_REPORT="${POC_SAVINGS_REPORT:-}"

# Timeout (s) d'attente du health-check du bridge au démarrage.
POC_BRIDGE_HEALTH_TIMEOUT="${POC_BRIDGE_HEALTH_TIMEOUT:-30}"

# ⚠ SÉCURITÉ : ne mets JAMAIS de clé API ici. En mode real, exporte-les dans ton
# shell AVANT `./poc.sh up --real` :
#   export ANTHROPIC_API_KEY=...   (et/ou OPENAI_API_KEY / GOOGLE_API_KEY)

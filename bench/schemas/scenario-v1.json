{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efe.example.com/schemas/efe-bench-harness/scenario-v1.json",
  "title": "EFE Public-Bench Scenario — schema v1",
  "description": "PR #21 § 10 + § 31 (Appendix B). STABILITY_CONTRACT v1.3 § 21 commitment. Frozen for ≥ 6 chart-minor versions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "duration", "loadgen"],
  "properties": {
    "schema_version": {
      "const": 1,
      "description": "Schema discriminator (AD37)."
    },
    "id": {
      "type": "string",
      "pattern": "^S[0-9]{2}_[a-z0-9_]+$",
      "minLength": 5,
      "maxLength": 64
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 256 },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(s|m|h)$",
      "description": "humantime — hard wall-clock cap"
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provisioner": { "enum": ["kind", "k3s", "external"] },
        "kind_image":  { "type": "string" },
        "k3s_version": { "type": "string" },
        "kubeconfig":  { "type": "string" },
        "topology": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "controller_replicas":   { "type": "integer", "minimum": 1, "maximum": 10 },
            "participant_replicas":  { "type": "integer", "minimum": 1, "maximum": 50 },
            "namespace":             { "type": "string", "pattern": "^[a-z0-9-]+$" }
          }
        }
      }
    },
    "loadgen": {
      "type": "object",
      "description": "Verbatim PR #20 loadgen profile-v1 (a subset is accepted).",
      "additionalProperties": true,
      "required": ["version", "name", "target", "pattern"],
      "properties": {
        "version": { "const": 1 },
        "name":    { "type": "string", "minLength": 1 },
        "target":  { "type": "object" },
        "pattern": { "type": "object" }
      }
    },
    "chaos": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "at_offset"],
        "properties": {
          "id":        { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "at_offset": { "type": "string", "pattern": "^[0-9]+(s|m|h|ms)$" },
          "crd_file":  {
            "type": "string",
            "pattern": "^pr21_meta_swarm/[a-z0-9-]+\\.yaml$",
            "description": "AD32 — path must stay inside deploy/chaos/pr21_meta_swarm/"
          },
          "action":    { "enum": ["delete-fault"] },
          "duration":  {
            "type": "string",
            "pattern": "^([0-9]+(s|m|h)|permanent)$"
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collect_prom_snapshot": { "type": "boolean", "default": false },
        "collect_chaos_events":  { "type": "boolean", "default": false },
        "output_dir":            { "type": "string" }
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p50_ms_max_delta_pct":           { "type": "number", "minimum": 0, "maximum": 200 },
        "p95_ms_max_delta_pct":           { "type": "number", "minimum": 0, "maximum": 200 },
        "p99_ms_max_delta_pct":           { "type": "number", "minimum": 0, "maximum": 200 },
        "error_rate_max_delta_pp":        { "type": "number", "minimum": 0, "maximum": 100 },
        "throughput_qps_min_delta_pct":   { "type": "number", "minimum": -100, "maximum": 100 },
        "recovery_time_s_max_delta_s":    { "type": "number", "minimum": 0, "maximum": 600 }
      }
    }
  }
}

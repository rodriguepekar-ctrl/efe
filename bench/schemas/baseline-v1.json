{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efe.example.com/schemas/efe-bench-harness/baseline-v1.json",
  "title": "EFE Public-Bench Baseline — schema v1",
  "description": "PR #21 § 34 Appendix E. STABILITY_CONTRACT v1.3 § 21.4 commitment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "metrics"],
  "properties": {
    "schema_version": { "const": 1 },
    "scenario_id":     { "type": "string", "pattern": "^S[0-9]{2}_[a-z0-9_]+$" },
    "harness_version": { "type": "string" },
    "loadgen_version": { "type": "string" },
    "chart_version":   { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "image_tag":       { "type": "string" },
    "git_commit":      { "type": "string", "pattern": "^[0-9a-f]{7,40}$|^unknown$" },
    "run_id":          { "type": "string" },
    "started_at":      { "type": "string", "format": "date-time" },
    "duration_s":      { "type": "number", "minimum": 0 },
    "total_requests":  { "type": "integer", "minimum": 0 },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p50_ms":          { "type": ["number", "null"], "minimum": 0 },
        "p95_ms":          { "type": ["number", "null"], "minimum": 0 },
        "p99_ms":          { "type": ["number", "null"], "minimum": 0 },
        "error_rate":      { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "throughput_qps":  { "type": ["number", "null"], "minimum": 0 },
        "recovery_time_s": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "chaos_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at_offset_s": { "type": "number", "minimum": 0 },
          "fault_id":    { "type": "string" },
          "event_type":  { "enum": ["apply", "delete", "completed"] },
          "crd_kind":    { "type": ["string", "null"] }
        }
      }
    },
    "verdict": { "type": ["string", "null"], "enum": ["pass", "warn", "fail", "no-baseline", null] }
  }
}

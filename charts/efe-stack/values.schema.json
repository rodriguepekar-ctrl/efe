{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EFE Stack values schema",
  "type": "object",
  "required": ["global"],
  "additionalProperties": true,
  "properties": {
    "global": {
      "type": "object",
      "required": ["tenant"],
      "additionalProperties": true,
      "properties": {
        "tenant": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^$|^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$",
          "description": "Tenant slug, 3-32 chars, [a-z0-9-]+, no leading/trailing hyphen. Empty default forces install-time override (enforced via `required` helper in templates)."
        },
        "domain": { "type": "string", "format": "hostname" },
        "environment": { "enum": ["prod", "staging", "dev", "poc"] },
        "imageRegistry": { "type": "string", "minLength": 1 },
        "storageClass": { "type": "string" },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string" } }
          }
        },
        "commonLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "externalPostgres": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "secretRef": {
              "type": "object",
              "required": ["name", "key"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "key": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "efe-server": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 100 },
        "image": {
          "type": "object",
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string" },
            "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "byok": {
          "type": "object",
          "properties": {
            "backend": {
              "enum": ["env", "file", "aws-kms", "gcp-kms", "azure-kv", "vault", "pkcs11"]
            },
            "awsKmsKeyId": { "type": "string" }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "m20HelperToolsEnabled": { "type": "boolean" },
            "m21Mode2Enabled": { "type": "boolean" },
            "m22Mode3Enabled": { "type": "boolean" },
            "d8AdminEnabled": { "type": "boolean" }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "resources": { "type": "object" },
        "service": { "type": "object" },
        "podDisruptionBudget": { "type": "object" },
        "topologySpreadConstraints": { "type": "object" },
        "networkPolicy": { "type": "object" },
        "serviceAccount": { "type": "object" },
        "envOverrides": { "type": "array" },
        "auditHmacSecretRef": {
          "type": "object",
          "required": ["name", "key"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "key": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "mcp-server": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 100 },
        "profile": {
          "enum": ["core", "advanced", "agent-native", "agent-native-deploy", "experimental"]
        }
      }
    },
    "portal-admin": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "postgres-operator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "cluster": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "name": { "type": "string", "minLength": 1 },
            "postgresVersion": { "type": "integer", "minimum": 14, "maximum": 17 }
          }
        }
      }
    },
    "redis-stack": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "storage": { "type": "string" },
        "maxMemoryPolicy": {
          "enum": [
            "noeviction",
            "allkeys-lru",
            "allkeys-lfu",
            "volatile-lru",
            "volatile-lfu",
            "allkeys-random",
            "volatile-random",
            "volatile-ttl"
          ]
        }
      }
    },
    "externalRedis": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "defaultDeny": { "type": "boolean" }
      }
    },
    "podSecurityPolicy": {
      "type": "object",
      "properties": {
        "enforce": { "enum": ["privileged", "baseline", "restricted"] }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    }
  }
}

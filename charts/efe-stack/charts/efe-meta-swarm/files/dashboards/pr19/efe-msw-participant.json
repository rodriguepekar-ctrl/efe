{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.2.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "uid": "efe-msw-participant",
  "title": "EFE Meta-Swarm — Participant Drill-down",
  "description": "One participant at a time. Step latency, error rates, TLS handshakes, payload sizes.",
  "tags": ["efe", "meta-swarm", "pr19", "participant"],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {"name": "prometheus_ds", "type": "datasource", "label": "Prometheus", "query": "prometheus", "current": {"text": "Prometheus", "value": "Prometheus"}},
      {"name": "cluster", "type": "query", "label": "Cluster", "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"}, "query": "label_values(efe_meta_swarm_build_info, cluster)", "refresh": 1, "includeAll": true, "multi": false, "current": {"text": "All", "value": "$__all"}},
      {"name": "env", "type": "query", "label": "Environment", "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"}, "query": "label_values(efe_meta_swarm_build_info{cluster=~\"$cluster\"}, env)", "refresh": 1, "includeAll": true, "multi": false, "current": {"text": "All", "value": "$__all"}},
      {"name": "participant_id", "type": "query", "label": "Participant", "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"}, "query": "label_values(efe_meta_swarm_step_total{cluster=~\"$cluster\",env=~\"$env\"}, participant_id)", "refresh": 2, "includeAll": false, "multi": false, "sort": 1}
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Participant up", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "max(efe_meta_swarm_participant_up{cluster=~\"$cluster\",env=~\"$env\",participant_id=\"$participant_id\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}},
      "options": {"colorMode": "background", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2, "type": "stat", "title": "Step success rate (5m)", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "100 * sum(rate(efe_meta_swarm_step_total{participant_id=\"$participant_id\",result=\"ok\"}[5m])) / clamp_min(sum(rate(efe_meta_swarm_step_total{participant_id=\"$participant_id\"}[5m])), 0.001)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 95}, {"color": "green", "value": 99}]}}},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3, "type": "stat", "title": "Step error rate (5m)", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "sum(rate(efe_meta_swarm_step_total{participant_id=\"$participant_id\",result=\"error\"}[5m]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.1}, {"color": "red", "value": 1}]}}},
      "options": {"colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4, "type": "stat", "title": "TLS handshake success (1h)", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "100 * sum(rate(efe_meta_swarm_tls_handshake_total{role=\"client\",result=\"ok\"}[1h])) / clamp_min(sum(rate(efe_meta_swarm_tls_handshake_total{role=\"client\"}[1h])), 0.001)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 99}, {"color": "green", "value": 99.9}]}}},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Step latency p50 / p95 / p99", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(efe_meta_swarm_step_duration_seconds_bucket{participant_id=\"$participant_id\"}[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(efe_meta_swarm_step_duration_seconds_bucket{participant_id=\"$participant_id\"}[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(efe_meta_swarm_step_duration_seconds_bucket{participant_id=\"$participant_id\"}[5m])))", "legendFormat": "p99", "refId": "C", "exemplar": true}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 5, "showPoints": "never"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.5}, {"color": "red", "value": 2}]}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6, "type": "timeseries", "title": "Step throughput by result (stacked)", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "sum by (result) (rate(efe_meta_swarm_step_total{participant_id=\"$participant_id\"}[5m]))", "legendFormat": "{{result}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 30, "stacking": {"mode": "normal", "group": "A"}, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"]}}
    },
    {
      "id": 7, "type": "timeseries", "title": "Step failure reasons", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "sum by (failure_reason) (rate(efe_meta_swarm_step_total{participant_id=\"$participant_id\",result=\"error\"}[5m]))", "legendFormat": "{{failure_reason}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"drawStyle": "line", "fillOpacity": 20, "stacking": {"mode": "normal", "group": "A"}, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Step payload bytes p95 (in / out)", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (direction, le) (rate(efe_meta_swarm_step_payload_bytes_bucket[5m])))", "legendFormat": "{{direction}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"drawStyle": "line", "fillOpacity": 5, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 9, "type": "timeseries", "title": "Safety violations for this participant", "gridPos": {"x": 0, "y": 18, "w": 24, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "sum by (kind) (rate(efe_meta_swarm_safety_violations_total{participant_id=\"$participant_id\"}[5m]))", "legendFormat": "{{kind}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "line", "fillOpacity": 20, "stacking": {"mode": "normal", "group": "A"}, "showPoints": "never"}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"]}}
    }
  ]
}

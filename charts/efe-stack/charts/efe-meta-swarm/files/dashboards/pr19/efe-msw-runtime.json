{
  "__inputs": [],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.2.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "uid": "efe-msw-runtime",
  "title": "EFE Meta-Swarm \u2014 Runtime / Process",
  "description": "Process CPU / memory / FDs + Kubernetes restarts / OOMKills + cardinality breach counter.",
  "tags": [
    "efe",
    "meta-swarm",
    "pr19",
    "runtime",
    "kubernetes"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus_ds",
        "type": "datasource",
        "label": "Prometheus",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "namespace",
        "type": "query",
        "label": "Namespace",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_ds}"
        },
        "query": "label_values(kube_pod_info, namespace)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "efe",
          "value": "efe"
        }
      },
      {
        "name": "pod",
        "type": "query",
        "label": "Pod",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_ds}"
        },
        "query": "label_values(kube_pod_info{namespace=~\"$namespace\", pod=~\".*efe-meta-swarm.*\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "runbook_base",
        "type": "constant",
        "query": "https://efe.example.com/runbook/meta-swarm",
        "current": {
          "text": "https://efe.example.com/runbook/meta-swarm",
          "value": "https://efe.example.com/runbook/meta-swarm"
        },
        "hide": 2,
        "skipUrlSync": true,
        "label": "runbook base URL"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage (cores)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "expr": "sum by (pod) (rate(process_cpu_seconds_total{namespace=~\"$namespace\", pod=~\"$pod\"}[5m]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "showPoints": "never"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1.5
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory (RSS)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "expr": "sum by (pod) (process_resident_memory_bytes{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Open file descriptors",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "expr": "sum by (pod) (process_open_fds{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} (open)",
          "refId": "A"
        },
        {
          "expr": "sum by (pod) (process_max_fds{namespace=~\"$namespace\", pod=~\"$pod\"})",
          "legendFormat": "{{pod}} (max)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 5,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "bargauge",
      "title": "Pod restarts (1h)",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\"$pod\"}[1h]))",
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        }
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Deployment available replicas",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=~\"$namespace\", deployment=~\".*efe-meta-swarm.*\"}",
          "legendFormat": "{{deployment}} (avail)",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_spec_replicas{namespace=~\"$namespace\", deployment=~\".*efe-meta-swarm.*\"}",
          "legendFormat": "{{deployment}} (spec)",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 5,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "OOMKills (24h)",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 6,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_terminated_reason{reason=\"OOMKilled\", namespace=~\"$namespace\", pod=~\"$pod\"}[24h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Cardinality breaches (total)",
      "gridPos": {
        "x": 18,
        "y": 14,
        "w": 6,
        "h": 6
      },
      "description": "PR #17 \u00a7 18.3 circuit breaker. >0 \u21d2 runaway label values; investigate immediately.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_ds}"
      },
      "targets": [
        {
          "expr": "sum(efe_meta_swarm_cardinality_breach_total)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 8,
      "type": "text",
      "title": "Runtime references",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Resource limits** : controllers run with 2-core / 4 GB ; participants with 1-core / 2 GB by default (see `values.yaml`).\n\n**Linked alert** : [A5 ControllerNotServing](${runbook_base}/RB_PR19_MSW5.md) when `up==0` for 1m.\n\n**Cardinality breach playbook** : PR #17 \u00a7 18.3 \u2014 investigate per-metric breach counter via D8 P7, file ticket if > 0."
      }
    }
  ]
}
{
  "__inputs": [],
  "__requires": [{"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.2.0"}, {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}],
  "uid": "efe-msw-reload",
  "title": "EFE Meta-Swarm — Manifest Reload Audit",
  "description": "Manifest reload history, success rate, failure breakdown by trigger and reason.",
  "tags": ["efe", "meta-swarm", "pr19", "reload"],
  "editable": false, "graphTooltip": 1, "timezone": "utc", "schemaVersion": 39, "version": 1, "refresh": "1m",
  "time": {"from": "now-24h", "to": "now"},
  "annotations": {
    "list": [
      {"builtIn": 1, "name": "Annotations & Alerts", "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "hide": true, "type": "dashboard"},
      {"name": "Reload events (success)", "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"}, "enable": true, "iconColor": "#5794F2", "expr": "changes(efe_meta_swarm_reload_gen[5m]) > 0", "tagKeys": "trigger", "titleFormat": "Reload OK (gen={{value}})"}
    ]
  },
  "templating": {
    "list": [
      {"name": "prometheus_ds", "type": "datasource", "label": "Prometheus", "query": "prometheus", "current": {"text": "Prometheus", "value": "Prometheus"}},
      {"name": "cluster", "type": "query", "label": "Cluster", "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"}, "query": "label_values(efe_meta_swarm_reload_gen, cluster)", "refresh": 1, "includeAll": true, "multi": false, "current": {"text": "All", "value": "$__all"}},
      {"name": "env", "type": "query", "label": "Environment", "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"}, "query": "label_values(efe_meta_swarm_reload_gen{cluster=~\"$cluster\"}, env)", "refresh": 1, "includeAll": true, "multi": false, "current": {"text": "All", "value": "$__all"}},
      {"name": "trigger", "type": "query", "label": "Trigger", "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"}, "query": "label_values(efe_meta_swarm_manifest_reload_total, trigger)", "refresh": 2, "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}}
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Current reload_gen", "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "max(efe_meta_swarm_reload_gen{cluster=~\"$cluster\",env=~\"$env\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "blue", "value": null}]}}},
      "options": {"colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2, "type": "stat", "title": "Reloads OK (24h)", "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "sum(increase(efe_meta_swarm_manifest_reload_total{result=\"ok\",cluster=~\"$cluster\",env=~\"$env\",trigger=~\"$trigger\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3, "type": "stat", "title": "Reloads errored (24h)", "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "sum(increase(efe_meta_swarm_manifest_reload_total{result=\"error\",cluster=~\"$cluster\",env=~\"$env\",trigger=~\"$trigger\"}[24h]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 3}]}}},
      "options": {"colorMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4, "type": "stat", "title": "Reload error rate (1h)", "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "100 * sum(rate(efe_meta_swarm_manifest_reload_total{result=\"error\"}[1h])) / clamp_min(sum(rate(efe_meta_swarm_manifest_reload_total[1h])), 0.001)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 5}, {"color": "red", "value": 25}]}}},
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 5, "type": "timeseries", "title": "Reload duration p50 / p95 / p99", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(efe_meta_swarm_manifest_reload_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(efe_meta_swarm_manifest_reload_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(efe_meta_swarm_manifest_reload_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "custom": {"drawStyle": "line", "fillOpacity": 5, "showPoints": "never"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.5}, {"color": "red", "value": 2}]}}},
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"]}}
    },
    {
      "id": 6, "type": "piechart", "title": "Reloads by trigger (24h, ok only)", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 6},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "sum by (trigger) (increase(efe_meta_swarm_manifest_reload_total{result=\"ok\"}[24h]))", "legendFormat": "{{trigger}}", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "pieType": "donut", "legend": {"displayMode": "table", "placement": "right", "values": ["value", "percent"]}}
    },
    {
      "id": 7, "type": "barchart", "title": "Reload failures by reason (legacy PR #12 surface)", "gridPos": {"x": 0, "y": 10, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "sum by (reason) (increase(efe_meta_swarm_reload_failures_total[24h]))", "legendFormat": "{{reason}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"axisCenteredZero": false, "lineWidth": 1, "fillOpacity": 80}}},
      "options": {"orientation": "horizontal", "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 8, "type": "table", "title": "Recent reload events", "gridPos": {"x": 12, "y": 10, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "${prometheus_ds}"},
      "targets": [{"expr": "increase(efe_meta_swarm_manifest_reload_total[1h])", "format": "table", "instant": true, "refId": "A"}],
      "transformations": [
        {"id": "filterFieldsByName", "options": {"include": {"names": ["Time", "trigger", "result", "Value"]}}},
        {"id": "organize", "options": {"renameByName": {"Value": "Count (last 1h)"}}}
      ]
    }
  ]
}

  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1e9}
            ]
          }
        }
      },
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}
      },
      "title": "Reload Generation",
      "targets": [
        {
          "expr": "max(efe_meta_swarm_reload_gen)",
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisLabel": "", "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "showPoints": "auto"},
          "unit": "ops"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 4, "y": 0},
      "id": 2,
      "title": "Reload Attempts (rate /s)",
      "targets": [
        {
          "expr": "sum(rate(efe_meta_swarm_reload_attempts_total[5m]))",
          "legendFormat": "attempts",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"axisLabel": "", "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 1, "stacking": {"mode": "normal", "group": "A"}},
          "unit": "ops"
        }
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "title": "Reload Failures by Reason",
      "targets": [
        {
          "expr": "sum(rate(efe_meta_swarm_reload_failures_total[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line", "lineInterpolation": "linear"},
          "unit": "µs"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "title": "Reload Duration p50/p90/p99 (µs)",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(efe_meta_swarm_reload_duration_microseconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, sum(rate(efe_meta_swarm_reload_duration_microseconds_bucket[5m])) by (le))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(efe_meta_swarm_reload_duration_microseconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line"},
          "unit": "ops"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "title": "Health Probes (success + error rates)",
      "targets": [
        {
          "expr": "sum(rate(efe_meta_swarm_health_probes_total[5m]))",
          "legendFormat": "probes/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(efe_meta_swarm_health_probe_errors_total[5m]))",
          "legendFormat": "errors/s",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {"drawStyle": "line"},
          "unit": "s"
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "id": 6,
      "title": "Health Probe Latency p99",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(efe_meta_swarm_health_probe_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "mappings": [
            {"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "green", "value": 1}]}
        }
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "id": 7,
      "title": "Pod Up Status (per role)",
      "targets": [
        {
          "expr": "up{job=~\".*meta-swarm-.*\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "type": "stat"
    }
  ],
  "refresh": "30s",

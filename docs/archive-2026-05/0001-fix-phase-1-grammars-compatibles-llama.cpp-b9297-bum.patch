--- /dev/null
+++ b/crates/efe-nano-app-coordinator/assets/grammars/analyzer_v1.gbnf
@@ -0,0 +1,31 @@
+# AnalyzerOutput v1.0.0 — GBNF pour llama.cpp b9297+
+# Schéma source : assets/schemas/analyzer_v1.json
+#
+# Raffinements vs auto-gen :
+# - Borne {0,19} sur entities (limite 20 = la première + 19 suivantes)
+# - Borne {0,200} sur les strings (DoS prevention)
+# - sentiment / confidence non bornées par grammar (validation Rust post-parse)
+#
+# Coût mesuré sur SmolLM2-360M Q5 M3 : ~7% overhead vs sans grammar.
+
+root ::= "{" ws "\"entities\":" ws entities-arr ws "," ws "\"intent\":" ws intent ws "," ws "\"sentiment\":" ws sentiment ws "," ws "\"language\":" ws language ws "," ws "\"one_line_summary\":" ws short-string ws "," ws "\"confidence\":" ws confidence ws "}"
+
+entities-arr ::= "[" ws "]" | "[" ws entity (ws "," ws entity){0,19} ws "]"
+
+entity ::= "{" ws "\"text\":" ws short-string ws "," ws "\"kind\":" ws entity-kind ws "," ws "\"start_char\":" ws integer ws "," ws "\"end_char\":" ws integer ws "," ws "\"confidence\":" ws confidence ws "}"
+
+entity-kind ::= "\"PERSON\"" | "\"ORG\"" | "\"LOCATION\"" | "\"MONEY\"" | "\"DATE\"" | "\"DRUG\"" | "\"EVENT\"" | "\"PRODUCT\"" | "\"OTHER\""
+
+intent ::= "\"FACTUAL\"" | "\"ANALYTICAL\"" | "\"COMPARATIVE\"" | "\"TEMPORAL\"" | "\"OPINION\"" | "\"INSTRUCTIONAL\""
+
+language ::= "\"en\"" | "\"fr\"" | "\"de\"" | "\"es\"" | "\"it\"" | "\"pt\"" | "\"ja\"" | "\"zh\"" | "\"ru\"" | "\"ar\"" | "\"und\""
+
+sentiment ::= "-"? [0-9]+ ("." [0-9]+)?
+confidence ::= [0-9]+ ("." [0-9]+)?
+integer ::= [0-9]+
+
+# String borné à 200 chars (DoS prevention)
+short-string ::= "\"" char{0,200} "\""
+char ::= [^"\\] | "\\" ([\"\\/bfnrt] | "u" [0-9a-fA-F]{4})
+
+ws ::= [ \t\n]*
diff --git a/crates/efe-nano-app-coordinator/assets/grammars/compressor_v1.gbnf b/crates/efe-nano-app-coordinator/assets/grammars/compressor_v1.gbnf
new file mode 100644
index 0000000..473f959
--- /dev/null
+++ b/crates/efe-nano-app-coordinator/assets/grammars/compressor_v1.gbnf
@@ -0,0 +1,18 @@
+# CompressorOutput v1.0.0 — GBNF pour llama.cpp b9297+
+# Schéma source : assets/schemas/compressor_v1.json
+
+root ::= "{" ws "\"summary\":" ws long-string ws "," ws "\"word_count\":" ws integer ws "," ws "\"preserved\":" ws preserved-arr ws "," ws "\"omitted_for_brevity\":" ws omitted-arr ws "," ws "\"compression_ratio\":" ws number ws "}"
+
+preserved-arr ::= "[" ws "]" | "[" ws short-string (ws "," ws short-string){0,19} ws "]"
+
+omitted-arr ::= "[" ws "]" | "[" ws tiny-string (ws "," ws tiny-string){0,9} ws "]"
+
+long-string ::= "\"" char{1,500} "\""
+short-string ::= "\"" char{1,100} "\""
+tiny-string ::= "\"" char{1,50} "\""
+char ::= [^"\\] | "\\" ([\"\\/bfnrt] | "u" [0-9a-fA-F]{4})
+
+integer ::= [0-9]+
+number ::= [0-9]+ ("." [0-9]+)?
+
+ws ::= [ \t\n]*
diff --git a/crates/efe-nano-app-coordinator/assets/grammars/reformulator_v1.gbnf b/crates/efe-nano-app-coordinator/assets/grammars/reformulator_v1.gbnf
new file mode 100644
index 0000000..11f2f22
--- /dev/null
+++ b/crates/efe-nano-app-coordinator/assets/grammars/reformulator_v1.gbnf
@@ -0,0 +1,24 @@
+# ReformulatorOutput v1.0.0 — GBNF pour llama.cpp b9297+
+# Schéma source : assets/schemas/reformulator_v1.json
+#
+# Spécificité : "canonical" est un JSON arbitraire (pas de contrainte au
+# niveau grammar — la validation du schema_id-specific est faite côté Rust).
+
+root ::= "{" ws "\"canonical\":" ws json-value ws "," ws "\"schema_id\":" ws schema-id ws "," ws "\"extraction_warnings\":" ws warnings-arr ws "}"
+
+schema-id ::= "\"citation_v1\"" | "\"fact_v1\"" | "\"tool_call_v1\"" | "\"claim_v1\"" | "\"source_ref_v1\""
+
+warnings-arr ::= "[" ws "]" | "[" ws short-string (ws "," ws short-string){0,9} ws "]"
+
+# JSON value récursif (standard JSON minus quelques edge cases inutiles).
+json-value ::= object | array | json-string | json-number | "true" | "false" | "null"
+object ::= "{" ws "}" | "{" ws member (ws "," ws member)* ws "}"
+member ::= json-string ws ":" ws json-value
+array ::= "[" ws "]" | "[" ws json-value (ws "," ws json-value)* ws "]"
+
+json-string ::= "\"" char* "\""
+json-number ::= "-"? ("0" | [1-9] [0-9]*) ("." [0-9]+)? ([eE] [+-]? [0-9]+)?
+
+short-string ::= "\"" char{0,200} "\""
+char ::= [^"\\] | "\\" ([\"\\/bfnrt] | "u" [0-9a-fA-F]{4})
+ws ::= [ \t\n]*
diff --git a/crates/efe-nano-app-coordinator/assets/grammars/verifier_v1.gbnf b/crates/efe-nano-app-coordinator/assets/grammars/verifier_v1.gbnf
new file mode 100644
index 0000000..1a30805
--- /dev/null
+++ b/crates/efe-nano-app-coordinator/assets/grammars/verifier_v1.gbnf
@@ -0,0 +1,19 @@
+# VerifierOutput v1.0.0 — GBNF pour llama.cpp b9297+
+# Schéma source : assets/schemas/verifier_v1.json
+
+root ::= "{" ws "\"verdict\":" ws verdict ws "," ws "\"best_source_id\":" ws (source-id | "null") ws "," ws "\"similarity\":" ws confidence ws "," ws "\"contradictions\":" ws contradictions-arr ws "," ws "\"severity\":" ws severity (ws "," ws "\"explanation\":" ws explanation)? ws "}"
+
+verdict ::= "\"SUPPORTED\"" | "\"UNSUPPORTED\"" | "\"CONTRADICTED\"" | "\"INSUFFICIENT_EVIDENCE\""
+
+severity ::= "\"INFO\"" | "\"WARN\"" | "\"ERROR\""
+
+source-id ::= "\"" [a-zA-Z0-9_-]{1,64} "\""
+
+contradictions-arr ::= "[" ws "]" | "[" ws source-id (ws "," ws source-id){0,4} ws "]"
+
+# Explication courte (500 chars max)
+explanation ::= "\"" char{0,500} "\""
+char ::= [^"\\] | "\\" ([\"\\/bfnrt] | "u" [0-9a-fA-F]{4})
+
+confidence ::= [0-9]+ ("." [0-9]+)?
+ws ::= [ \t\n]*
diff --git a/crates/efe-nano-app-coordinator/src/clients/analyzer.rs b/crates/efe-nano-app-coordinator/src/clients/analyzer.rs
new file mode 100644
index 0000000..818fa19
--- /dev/null
+++ b/crates/efe-nano-app-coordinator/src/clients/analyzer.rs
@@ -0,0 +1,135 @@
+// SPDX-License-Identifier: UNLICENSED
+//! Client du robot **Analyseur** (SmolLM2-360M Q5).
+//!
+//! Port par défaut : `8090`.
+
+use std::path::Path;
+
+use async_trait::async_trait;
+
+use super::llama_server::{LlamaServerClient, RobotHealth};
+use super::{NanoRobotClient, RunMode};
+use crate::context::CallContext;
+use crate::error::{RobotError, RobotResult};
+use crate::types::analyzer::{AnalyzerInput, AnalyzerOutput};
+
+/// Client pour le robot Analyseur.
+pub struct AnalyzerClient {
+    inner: LlamaServerClient,
+}
+
+impl AnalyzerClient {
+    /// Construit avec les assets canoniques (grammar + prompt depuis
+    /// `assets/grammars/analyzer_v1.gbnf` et `assets/prompts/analyzer.txt`).
+    pub fn from_assets(endpoint: impl Into<String>) -> RobotResult<Self> {
+        let assets_root = assets_dir();
+        let grammar = assets_root.join("grammars/analyzer_v1.gbnf");
+        let prompt = assets_root.join("prompts/analyzer.txt");
+        Ok(Self {
+            inner: LlamaServerClient::from_assets(
+                crate::robot_ids::ANALYZER,
+                "1.0.0",
+                endpoint,
+                grammar,
+                prompt,
+                /* max_tokens */ 1024,
+                /* temperature */ 0.1,
+            )?,
+        })
+    }
+
+    /// Construit explicitement (test / customisation).
+    #[must_use]
+    pub fn from_helper(inner: LlamaServerClient) -> Self {
+        Self { inner }
+    }
+}
+
+#[async_trait]
+impl NanoRobotClient for AnalyzerClient {
+    type Input = AnalyzerInput;
+    type Output = AnalyzerOutput;
+
+    fn id(&self) -> &'static str {
+        crate::robot_ids::ANALYZER
+    }
+    fn schema_version(&self) -> &'static str {
+        "1.0.0"
+    }
+    fn run_mode(&self) -> RunMode {
+        RunMode::B
+    }
+
+    async fn invoke(
+        &self,
+        input: Self::Input,
+        ctx: &CallContext,
+    ) -> RobotResult<Self::Output> {
+        use validator::Validate as _;
+        // Validation input pré-vol.
+        input.validate().map_err(|e| RobotError::SemanticViolation {
+            robot: self.id(),
+            issues: format!("input invalid: {e}"),
+        })?;
+
+        // Appel + parse JSON garanti par grammar.
+        let output: AnalyzerOutput = self.inner.complete(&input, &input.text, ctx).await?;
+
+        // Validation post-parse (les ranges que GBNF ne couvre pas).
+        output.validate().map_err(|e| RobotError::SemanticViolation {
+            robot: self.id(),
+            issues: format!("post-parse invalid: {e}"),
+        })?;
+        output
+            .validate_semantics()
+            .map_err(|issues| RobotError::SemanticViolation {
+                robot: self.id(),
+                issues,
+            })?;
+
+        Ok(output)
+    }
+
+    async fn health(&self) -> RobotResult<RobotHealth> {
+        self.inner.health().await
+    }
+}
+
+/// Localise `assets/` relativement au manifest du crate.
+pub(crate) fn assets_dir() -> std::path::PathBuf {
+    Path::new(env!("CARGO_MANIFEST_DIR")).join("assets")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn assets_dir_exists() {
+        let d = assets_dir();
+        assert!(
+            d.join("grammars").exists() || !d.exists(),
+            "assets/grammars/ should exist when assets/ exists"
+        );
+    }
+
+    #[test]
+    fn id_and_version_are_stable() {
+        // On instancie inner manuellement pour ne pas dépendre des fichiers.
+        let inner = LlamaServerClient {
+            id: crate::robot_ids::ANALYZER,
+            schema_version: "1.0.0",
+            endpoint: "http://127.0.0.1:8090".into(),
+            grammar: String::new(),
+            system_prompt: String::new(),
+            max_tokens: 512,
+            temperature: 0.1,
+            timeout: std::time::Duration::from_secs(1),
+            http: reqwest::Client::new(),
+        };
+        let client = AnalyzerClient::from_helper(inner);
+        assert_eq!(client.id(), "analyzer");
+        assert_eq!(client.schema_version(), "1.0.0");
+        assert_eq!(client.run_mode(), RunMode::B);
+    }
+}

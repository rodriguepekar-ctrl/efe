# ── Profil `souverain` — scellement réel, aucun egress vers un tiers ───────────
# Le profil de référence : la provenance est non-forgeable, le bundle exportable,
# l'ancre publiée, et RIEN ne quitte le périmètre. Le relais SLM, s'il est
# configuré, doit pointer sur un hôte LOCAL — le binaire avertit sinon.
#
# LE SECRET N'EST PAS ICI, et ne doit jamais y être :
#     export EFE_NANO_AUDIT_HMAC_MASTER=$(openssl rand -hex 32)
# Sans lui, le rapport dira `provenance : DÉGRADÉE` — jamais un faux vert.

EFE_SWARM_GATEWAY_ADDR=0.0.0.0:8080

# Provenance : export + ancre + attestation.
EFE_SWARM_BUNDLE_ENABLED=true
EFE_SWARM_ANCHOR_LOG=/var/lib/scella/anchors.log
# EFE_SWARM_BUNDLE_SIGNING_SEED=<graine ed25519, injectée au déploiement>

# Souveraineté : aucun appel frontière, caviardage armé.
EFE_LLM_FRONTIER_ENABLED=false
EFE_PII_DEFAULT_POLICY=redact

# Le relais SLM local (optionnel) — hôte local obligatoire, sinon avertissement.
# EFE_SLM_REFORMULATOR_URL=http://127.0.0.1:8081

# Capacité : plafonds explicites plutôt que des défauts découverts en production.
EFE_GATEWAY_MAX_INFLIGHT_RUNS=16
EFE_GATEWAY_MAX_WIDTH=32
EFE_GATEWAY_MAX_DEADLINE_MS=300000

# ── M2 : l'observation NON INTRUSIVE ────────────────────────────────────────
#  C'est la posture d'un déploiement que quelqu'un ADOPTE. Sans elle, un échec
#  de persistance fait échouer la requête du client : il perd une réponse déjà
#  calculée, parce que le sous-système d'audit a hoqueté. Aucune équipe ne prend
#  cet engagement d'architecture pour une fonction de conformité.
#
#  Avec elle, la réponse part, et la brèche est dite en trois endroits — au
#  client dans sa réponse, à l'exploitant dans /metrics, à l'auditeur dans
#  GET /v1/swarm/gaps. Un run non persisté n'est PAS effacé : il est documenté.
#
#  La souveraineté, elle, ne bouge pas d'un pouce : l'egress reste fermé, le
#  garde de démarrage reste fail-closed. Les deux pannes n'ont pas le même coût.
EFE_SWARM_CAPTURE_POLICY=observation

# ── Scella · profil « docker » ────────────────────────────────────────────────
#
#  Le profil de la démonstration en UNE commande : `docker compose up` sur une
#  machine où rien n'est installé.
#
#  Il ne pose AUCUN secret, et c'est le cœur de ce qu'il démontre. Sans
#  EFE_NANO_AUDIT_HMAC_MASTER, la passerelle démarre sur la clé de TEST PUBLIQUE
#  et M0 l'annonce en toutes lettres au démarrage : « provenance DÉGRADÉE ». Le
#  reçu produit démontre donc le MÉCANISME, jamais la SUBSTANCE.
#
#  C'est délibéré : une démonstration qui aurait l'air meilleure qu'elle n'est
#  serait le défaut exact que M0 existe pour supprimer. Pour qu'un reçu oppose
#  quelque chose à quelqu'un, il faut une clé que vous seul détenez :
#
#      docker compose run --rm -e EFE_NANO_AUDIT_HMAC_MASTER=$(openssl rand -hex 32) passerelle
#
#  Écoute sur 0.0.0.0 — contrairement à la console de conformité, qui GARDE son
#  bind au loopback (`assert_local`). L'asymétrie est voulue : une passerelle est
#  faite pour recevoir du trafic, une console d'audit ne l'est pas.
#
EFE_SWARM_GATEWAY_ADDR=0.0.0.0:8080

#  L'export de bundle : sans lui, pas d'ancre, donc pas de détection de
#  troncature — et la démonstration perd sa seule propriété SANS CLÉ.
EFE_SWARM_BUNDLE_ENABLED=true

#  L'ancre, publiée HORS du bundle, sur le volume partagé avec le prouveur.
#  C'est le seul témoin d'une troncature : le préfixe d'une chaîne scellée
#  valide est lui-même valide, et rien à l'intérieur du bundle ne trahit la coupure.
EFE_SWARM_ANCHOR_LOG=/preuve/anchors.log

#  Aucun egress. La démonstration ne sort pas de la machine.
EFE_LLM_FRONTIER_ENABLED=false

#  M2 : l'observation non intrusive — la posture d'un déploiement qu'on ADOPTE.
EFE_SWARM_CAPTURE_POLICY=observation

# ── Scella · profil « jonction » ──────────────────────────────────────────────
#
#  Le déploiement qui prend LES DEUX produits : le coin (la passerelle souveraine
#  à reçu) ET l'expansion (le registre d'évidence réglementaire).
#
#  Il exige un binaire construit avec la feature :
#      cargo build --release -p efe-swarm-gateway --features reg-evidence
#
#  Sans elle, les deux interrupteurs ci-dessous sont lus, le rapport de démarrage
#  annonce « pont réglementaire DÉGRADÉE », et aucun dossier n'apparaît. C'est
#  voulu : la séparation des deux produits est MÉCANIQUE, pas déclarative — un
#  test (`deux_produits_separables.rs`) l'exige du manifeste.
#
EFE_SWARM_GATEWAY_ADDR=0.0.0.0:8080

#  M2 : l'observation non intrusive — la posture d'un déploiement qu'on adopte.
EFE_SWARM_CAPTURE_POLICY=observation

#  L'export de bundle et l'ancre : ce qui rend un reçu opposable hors bande.
EFE_SWARM_BUNDLE_ENABLED=true
EFE_SWARM_ANCHOR_LOG=/preuve/anchors.log

#  ── M5 : le pont vers le registre ────────────────────────────────────────────
#  Un sous-dossier par run, contenant l'artefact, la lecture versionnée qui l'a
#  produit, et le mode d'emploi de la re-dérivation. Ces trois fichiers suffisent
#  à un tiers pour RE-CALCULER l'artefact sans nous croire.
EFE_SWARM_REG_EVIDENCE_DIR=/preuve/reg

#  Le cadre visé. Jamais deviné : une valeur hors énumération laisse le pont
#  ÉTEINT et se voit signalée au démarrage, parce que se tromper de cadre produit
#  un dossier qui a l'air correct et répond à la mauvaise question.
#  Valeurs : eu_ai_act · gdpr · csddd · lksg
EFE_SWARM_REG_FRAMEWORK=eu_ai_act

#  Aucun egress frontière dans ce profil.
EFE_LLM_FRONTIER_ENABLED=false

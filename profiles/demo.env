# ── Profil `demo` — tout local, aucun egress, rien à croire ────────────────────
# Ce que ce profil sert : le MÉCANISME du reçu, de bout en bout, sur une machine
# sans compte ni clé d'API. Ce qu'il ne sert PAS : une preuve opposable — la clé
# de provenance est la clé de TEST PUBLIQUE, et le rapport le dit.
#
# Aucun secret n'est posé ici : c'est délibéré, et c'est ce qui rend ce profil
# honnête. Le rapport affichera `provenance : DÉGRADÉE`.

EFE_SWARM_GATEWAY_ADDR=127.0.0.1:8080

# L'export vers un vérifieur tiers, et l'ancre qui rend la troncature détectable
# sans clé. Les deux sont locaux : rien ne sort.
EFE_SWARM_BUNDLE_ENABLED=true
EFE_SWARM_ANCHOR_LOG=demo-bundles/local-receipt/anchors.log

# Aucun appel frontière. L'allowlist reste absente ⟹ fail-closed total.
EFE_LLM_FRONTIER_ENABLED=false

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efe.example/schemas/d16/manifest.schema.json",
  "title": "EFE D16 Embedder Bundle Manifest",
  "description": "Authoritative metadata schema for an EFE embedder bundle. Cf. docs/bench/d16_embedder_bundling_architecture.md §4 + docs/EFE_BUNDLES_EXTENSION_ARCHITECTURE.md §8. Pin tested by `test_m13_d16_schema_*`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "bundle_id",
    "framework",
    "dim",
    "components",
    "runtime",
    "build",
    "license"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "const": "1.0",
      "description": "Manifest schema version. Bumped on breaking changes; M13 ships v1.0."
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._/-]+@[0-9]+\\.[0-9]+\\.[0-9]+/[a-z]+/[0-9]+$",
      "description": "{family}/{name}@{semver}/{framework}/{dim}, e.g. 'sentence-transformers/all-MiniLM-L6-v2@1.0.0/onnx/384'"
    },
    "bundle_slug": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+-[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Filesystem-safe identifier `{name}-{lang}-{version}` used as directory name + OCI tag. Accepts mixed case (e.g., `paraphrase-multilingual-MiniLM-L12-v2-1.0.0`)."
    },
    "framework": {
      "type": "string",
      "enum": ["onnx", "safetensors"],
      "description": "Weight format. ONNX preferred (runtime portability + GPU EP); safetensors fallback."
    },
    "dim": {
      "type": "integer",
      "minimum": 32,
      "maximum": 8192,
      "description": "Output embedding dimension. Pinned at fingerprint level."
    },
    "quantization": {
      "type": "string",
      "enum": ["none", "fp16", "bf16", "int8-dynamic", "int8-static", "int4"],
      "description": "Quantization scheme applied to the weights (informational; runtime.dtype is authoritative for inference)."
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "required"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._/-]+$",
            "description": "Path relative to the bundle root, e.g. 'weights/model.onnx'."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Lowercase hex SHA-256 of the file bytes."
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "required": {
            "type": "boolean",
            "description": "If true, loader fails closed when component is absent or hash mismatches."
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_seq_len", "pooling", "normalize", "dtype"],
      "properties": {
        "max_seq_len": {
          "type": "integer",
          "minimum": 16,
          "maximum": 32768
        },
        "pooling": {
          "type": "string",
          "enum": ["mean", "cls", "max", "weighted_mean"]
        },
        "normalize": {
          "type": "boolean"
        },
        "dtype": {
          "type": "string",
          "enum": ["float32", "float16", "bfloat16"]
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder", "built_at_unix_ms", "git_sha", "source_date_epoch"],
      "properties": {
        "builder": {
          "type": "string",
          "description": "URI of the CI run, or `local-dev` for dev-mode bootstrap."
        },
        "built_at_unix_ms": {
          "type": "integer",
          "minimum": 0
        },
        "git_sha": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|local-dev)$",
          "description": "Git commit SHA at build time, or `local-dev` for dev-mode."
        },
        "source_date_epoch": {
          "type": "integer",
          "minimum": 0,
          "description": "SOURCE_DATE_EPOCH used for reproducibility."
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx_id"],
      "properties": {
        "spdx_id": {
          "type": "string",
          "description": "SPDX identifier of the model license, e.g. 'Apache-2.0'."
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "redistribution_allowed": {
          "type": "boolean"
        }
      }
    },
    "model_origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "huggingface_repo": { "type": "string" },
        "huggingface_revision": {
          "type": "string",
          "pattern": "^([0-9a-f]{40}|dev-placeholder)$",
          "description": "Pinned 40-char HF revision SHA. Threat T-M13-7 mitigation : `main` is forbidden."
        },
        "model_card_url": { "type": "string", "format": "uri" }
      }
    },
    "sbom_path": {
      "type": "string",
      "description": "Relative path to a CycloneDX 1.5 SBOM file."
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "pubkey_id"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["ed25519"]
        },
        "pubkey_id": {
          "type": "string",
          "description": "Trust-store key_id used to sign this manifest."
        }
      }
    },
    "is_dev_unsigned": {
      "type": "boolean",
      "description": "True for dev-mode placeholder bundles (no real model). Loader refuses these in prod (EFE_BUNDLE_REQUIRE_SIGNATURE=true)."
    },
    "notes": {
      "type": "string"
    }
  }
}

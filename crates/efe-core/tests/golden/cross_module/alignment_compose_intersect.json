{
  "op": "cross_module/alignment_compose_intersect",
  "version": "1.0",
  "note": "End-to-end: intersect_cones with a single matching pair (cos = 1.0 ≥ threshold 0.9). Cone A has 2 anchors [1,0] and [0,1]; cone B has [1,0] only; only A's first anchor matches.",
  "inputs": {
    "cone_a_anchors": { "shape": [2, 2], "data": [1.0, 0.0, 0.0, 1.0] },
    "cone_a_radius": 0.5,
    "cone_b_anchors": { "shape": [1, 2], "data": [1.0, 0.0] },
    "cone_b_radius": 0.4,
    "threshold": 0.9
  },
  "expected": {
    "kept_anchors": { "shape": [1, 2], "data": [1.0, 0.0] },
    "kept_radius": 0.4
  },
  "tolerance": { "rtol": 0.0, "atol": 1.0e-7 }
}

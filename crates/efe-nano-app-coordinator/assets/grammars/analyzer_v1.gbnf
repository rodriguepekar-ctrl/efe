# AnalyzerOutput v1.0.0 — GBNF pour llama.cpp b9297+
# Schéma source : assets/schemas/analyzer_v1.json
#
# Raffinements vs auto-gen :
# - Borne {0,4} sur entities (limite 5 = la première + 4 suivantes) — C-B right-size
#   (mesuré : ~20 entités hallucinées = 682 t de décodage = ~3,8 s ; 5 → ~1,2 s)
# - Borne {0,200} sur les strings (DoS prevention)
# - sentiment / confidence non bornées par grammar (validation Rust post-parse)
#
# Coût mesuré sur SmolLM2-360M Q5 M3 : ~7% overhead vs sans grammar.

root ::= "{" ws "\"entities\":" ws entities-arr ws "," ws "\"intent\":" ws intent ws "," ws "\"sentiment\":" ws sentiment ws "," ws "\"language\":" ws language ws "," ws "\"one_line_summary\":" ws short-string ws "," ws "\"confidence\":" ws confidence ws "}"

entities-arr ::= "[" ws "]" | "[" ws entity (ws "," ws entity){0,4} ws "]"

entity ::= "{" ws "\"text\":" ws short-string ws "," ws "\"kind\":" ws entity-kind ws "," ws "\"start_char\":" ws integer ws "," ws "\"end_char\":" ws integer ws "," ws "\"confidence\":" ws confidence ws "}"

entity-kind ::= "\"PERSON\"" | "\"ORG\"" | "\"LOCATION\"" | "\"MONEY\"" | "\"DATE\"" | "\"DRUG\"" | "\"EVENT\"" | "\"PRODUCT\"" | "\"OTHER\""

intent ::= "\"FACTUAL\"" | "\"ANALYTICAL\"" | "\"COMPARATIVE\"" | "\"TEMPORAL\"" | "\"OPINION\"" | "\"INSTRUCTIONAL\""

language ::= "\"en\"" | "\"fr\"" | "\"de\"" | "\"es\"" | "\"it\"" | "\"pt\"" | "\"ja\"" | "\"zh\"" | "\"ru\"" | "\"ar\"" | "\"und\""

sentiment ::= "-"? [0-9]+ ("." [0-9]+)?
confidence ::= [0-9]+ ("." [0-9]+)?
integer ::= [0-9]+

# String borné à 200 chars (DoS prevention)
short-string ::= "\"" char{0,200} "\""
char ::= [^"\\] | "\\" ([\"\\/bfnrt] | "u" [0-9a-fA-F]{4})

ws ::= [ \t\n]*

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efe-projet.com/schemas/compressor_v1.json",
  "title": "CompressorOutput",
  "description": "Strict output of the L3 Compressor (Llama-3.2-1B Q5). Constrained summarization with entity preservation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "word_count", "preserved", "omitted_for_brevity", "compression_ratio"],
  "properties": {
    "summary":             {"type": "string",  "minLength": 1, "maxLength": 2000},
    "word_count":          {"type": "integer", "minimum": 1, "maximum": 500},
    "preserved":           {"type": "array", "maxItems": 50, "items": {"type": "string", "maxLength": 200}},
    "omitted_for_brevity": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 100}},
    "compression_ratio":   {"type": "number", "minimum": 1.0, "maximum": 50.0}
  }
}

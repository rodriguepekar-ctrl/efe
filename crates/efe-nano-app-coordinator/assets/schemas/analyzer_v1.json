{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efe-projet.com/schemas/analyzer_v1.json",
  "title": "AnalyzerOutput",
  "description": "Strict output of the L0 Analyzer nano-robot (SmolLM2-360M Q5).",
  "type": "object",
  "additionalProperties": false,
  "required": ["entities", "intent", "sentiment", "language", "one_line_summary", "confidence"],
  "properties": {
    "entities": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "kind", "start_char", "end_char", "confidence"],
        "properties": {
          "text":       {"type": "string", "minLength": 1, "maxLength": 200},
          "kind":       {"enum": ["PERSON", "ORG", "LOCATION", "MONEY", "DATE", "DRUG", "EVENT", "PRODUCT", "OTHER"]},
          "start_char": {"type": "integer", "minimum": 0},
          "end_char":   {"type": "integer", "minimum": 0},
          "confidence": {"type": "number",  "minimum": 0, "maximum": 1}
        }
      }
    },
    "intent": {
      "enum": ["FACTUAL", "ANALYTICAL", "COMPARATIVE", "TEMPORAL", "OPINION", "INSTRUCTIONAL"]
    },
    "sentiment": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "language": {
      "enum": ["en", "fr", "de", "es", "it", "pt", "ja", "zh", "ru", "ar", "und"]
    },
    "one_line_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}

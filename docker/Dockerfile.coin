# syntax=docker/dockerfile:1.7
#
# ═══ Scella — M4 : la démonstration en une commande ═══════════════════════════
#
# Une image, QUATRE binaires, aucun shell.
#
#   efe-swarm-gateway   la passerelle souveraine
#   scella-preuve       le pilote de la démonstration (il conduit, il ne prouve pas)
#   verify-mini         le vérifieur tiers — arbre de dépendances VIDE
#   provenance-verify   le SECOND vérifieur, le seul qui sache lire une ancre (P.4)
#
# Cet en-tête a annoncé « trois binaires » pendant tout le temps où il y en avait
# quatre : É1 a ajouté `provenance-verify` sans corriger la phrase qui les compte.
# Un fichier dont l'en-tête ment sur son contenu est le défaut que ce dépôt
# poursuit partout ailleurs ; il n'avait pas à commencer ici.
#
# Pourquoi les quatre dans UNE image : la démonstration doit tenir en un `docker
# compose up`. Deux images, ce serait deux builds d'un même workspace, donc deux
# fois la même attente pour rien.
#
# Pourquoi distroless : ni shell, ni gestionnaire de paquets, ni utilitaires.
# Une image de démonstration est ce qu'un inconnu exécute EN PREMIER — c'est le
# pire moment pour lui livrer une surface d'attaque en cadeau. C'est aussi
# pourquoi le pilote est un binaire Rust et non un script : sans shell, un
# script n'aurait rien pour tourner.
#
# Build (depuis la racine du dépôt) :
#   docker compose build
#
# Le premier build est LONG : il compile la fermeture de la passerelle depuis
# zéro. Les suivants réutilisent le cache de couches.

ARG RUST_VERSION=1.88
# **M5** — les features à compiler. Vide par défaut : l'image du coin ne contient RIEN de
# l'expansion, ce qui est la propriété que `deux_produits_separables.rs` garde au niveau du crate.
# `compose.yaml` passe `reg-evidence` pour le service « jonction », et lui seul.
ARG CARGO_FEATURES=

# ── Étage 1 : compilation ─────────────────────────────────────────────────────
FROM rust:${RUST_VERSION}-bookworm AS builder
WORKDIR /src

# Le contexte exclut `target/` via .dockerignore — sans quoi il pèserait ~116 Go.
COPY . .

# `--locked` : le build échoue si `Cargo.lock` n'est pas à jour, plutôt que de
# résoudre silencieusement d'autres versions que celles qui ont été testées.
# On ne compile QUE les trois fermetures nécessaires, pas les 68 membres.
ARG CARGO_FEATURES
RUN cargo build --release --locked \
      -p efe-swarm-gateway \
      -p scella-preuve \
      -p verify-mini \
      -p provenance-verify \
      ${CARGO_FEATURES:+--features "$CARGO_FEATURES"}

# Le dossier de travail partagé, créé ICI avec le bon propriétaire : distroless
# n'a pas de shell pour faire un `chown`, et un volume nommé hérite du
# propriétaire du dossier de l'image lors de sa première initialisation.
RUN mkdir -p /preuve && chown -R 65532:65532 /preuve

# ── Étage 2 : exécution ───────────────────────────────────────────────────────
FROM gcr.io/distroless/cc-debian12:nonroot AS runtime

COPY --from=builder /src/target/release/efe-swarm-gateway /usr/local/bin/efe-swarm-gateway
COPY --from=builder /src/target/release/scella-preuve     /usr/local/bin/scella-preuve
COPY --from=builder /src/target/release/verify-mini       /usr/local/bin/verify-mini
# **Fil P / P.4** — le SECOND vérifieur. Il manquait, et son absence était silencieuse : l'image
# démarrait, la démonstration passait, et pourtant elle ne pouvait pas faire ce que P.4 DÉFINIT —
# « `verify_against_root` appelé avec une ancre reçue par un canal DISTINCT ». `verify-mini` ne
# connaît pas `--anchor` (`grep -c anchor` sur son main.rs et son lib.rs → 0/0), donc AUCUN binaire
# de l'image ne savait lire un journal d'ancres. Le OnePager vend pourtant « deux vérifieurs
# autonomes » : sans celui-ci, l'image n'en portait qu'un.
COPY --from=builder /src/target/release/provenance-verify /usr/local/bin/provenance-verify
COPY --from=builder --chown=65532:65532 /preuve /preuve
# ── /var/lib/scella — le chemin du profil de PRODUCTION ───────────────────────
#
#  Il manquait, et son absence était invisible jusqu'au 6 septembre 2026.
#  `profiles/production.env` écrit son ancre dans `/var/lib/scella/anchors.log`,
#  et `compose.yaml` y monte le volume `preuve`. Or Docker initialise un volume
#  NEUF depuis le contenu de l'image au point de montage — propriétaire compris.
#  Ce chemin n'existant pas dans l'image, le volume naissait `root:root`, et le
#  conteneur tourne en 65532 : la première publication d'ancre échouait en
#  « Permission denied (os error 13) », et `GET /v1/swarm/bundle/:id` rendait 500.
#
#  ⚠ AUTREMENT DIT : le profil de production n'avait JAMAIS produit de bundle
#  dans Docker. `p1-check.sh` ne pouvait pas le voir — il lance le binaire de
#  l'HÔTE, pas le conteneur, et l'hôte écrit dans un répertoire qu'il possède.
#  Seul le chemin d'un inconnu (`scripts/mon-premier-recu.sh`) passe par ici.
#  C'est très exactement ce que l'étape D5 existe pour trouver.
#
#  On réemploie le `/preuve` vide de l'étage builder : distroless n'a pas de shell,
#  donc pas de `RUN mkdir` possible à cet étage.
COPY --from=builder --chown=65532:65532 /preuve /var/lib/scella

# Le profil est livré dans l'image pour être LISIBLE par qui inspecte l'image.
# Il n'est pas lu par elle : c'est `compose.yaml` qui l'injecte via `env_file`,
# depuis le dépôt — le même fichier que le test T2 de M0 vérifie. Une seule
# source de vérité, et elle est sous test.
COPY --from=builder /src/profiles/docker.env /etc/scella/docker.env

USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/efe-swarm-gateway"]

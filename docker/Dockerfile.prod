# syntax=docker/dockerfile:1.7
#
# EFE production image — MVP (M12).
#
# Design (cf. M12_ARCHITECTURE.md §11):
#   * distroless-cc-debian12:nonroot  → zero-shell, zero-package-manager runtime
#   * multi-stage with cargo-chef      → dependency layer cached across builds
#   * strip + --locked                 → smaller + reproducible binary
#   * grpc_health_probe static binary  → liveness/readiness via gRPC
#   * UID/GID 10001 non-root           → least privilege
#   * SOURCE_DATE_EPOCH honoured       → bit-reproducible (identical digest for same SHA)
#
# Build:
#   docker buildx build \
#     --build-arg SOURCE_DATE_EPOCH=$(git log -1 --format=%ct) \
#     --platform linux/amd64 \
#     -t ghcr.io/efe-project/efe:$(git rev-parse --short HEAD) \
#     -f docker/Dockerfile.prod .
#
# Run (locally, without auth):
#   docker run --rm -p 50051:50051 -p 9090:9090 \
#     -e RUST_LOG=info,efe=debug \
#     ghcr.io/efe-project/efe:latest

# Φ-D-OPS post-audit round-2 fix B1' : the workspace
# `rust-toolchain.toml` channel + `Cargo.toml rust-version = "1.88"`
# (driven by `time 0.3.47`'s rustc-1.88.0 MSRV) require 1.88 minimum.
# Pre-round-2 default `1.85.0` worked only because every `docker build`
# call passed `--build-arg RUST_VERSION=1.88` explicitly ; an
# unscripted build would silently fall back to 1.85 and fail to
# compile the workspace.
ARG RUST_VERSION=1.88
# Φ-D-OPS post-audit round-3 fix B1'' : the official rust Docker Hub
# tag is `rust:<ver>-slim-bookworm` (cf. `docker manifest inspect`).
# Pre-fix `bookworm-slim` produced `rust:1.88-bookworm-slim` which
# does NOT exist on Docker Hub ; every build succeeded only because
# a prior tag was already in the local layer cache. A fresh CI runner
# would fail at the `[internal] load metadata` step. The previous
# round-2 R2-B1 fix (default `RUST_VERSION=1.88`) made this latent
# bug observable for the first time — round-3 closes it.
ARG DEBIAN_VARIANT=slim-bookworm
ARG CHEF_VERSION=0.1.67
ARG GRPC_HEALTH_PROBE_VERSION=v0.4.25
ARG SOURCE_DATE_EPOCH=0

# ---------------------------------------------------------------------
# Stage 1 : planner
#
# `cargo chef prepare` walks the workspace and emits a `recipe.json`
# describing exactly which crates need compilation. This lets the next
# stage cache the dependency build even when the application source
# changes — our biggest cache hit in CI.
# ---------------------------------------------------------------------
FROM rust:${RUST_VERSION}-${DEBIAN_VARIANT} AS planner
WORKDIR /app
ARG CHEF_VERSION
RUN cargo install cargo-chef --locked --version ${CHEF_VERSION}
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

# ---------------------------------------------------------------------
# Stage 2 : cacher
#
# Pre-compile every dependency against the pinned recipe. Because this
# stage does not copy our application source, editing `src/*.rs` does
# not invalidate the cargo cache layer.
# ---------------------------------------------------------------------
FROM rust:${RUST_VERSION}-${DEBIAN_VARIANT} AS cacher
WORKDIR /app
ARG CHEF_VERSION
RUN cargo install cargo-chef --locked --version ${CHEF_VERSION}
# Φ-D-OPS Docker fix : `python3` is required because the workspace
# contains `efe-ffi` whose `pyo3-build-config` build-script probes
# the Python interpreter to derive the abi3 link target. The runtime
# image is distroless and never sees Python — this dep is only used
# during dep compilation in cargo-chef cook.
RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev protobuf-compiler python3 python3-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json

# ---------------------------------------------------------------------
# Stage 3 : builder
#
# Compile the application binary against the cached dependency target.
# `--locked` refuses to resolve Cargo.lock dynamically (reproducibility
# guarantee). `strip` removes debug symbols from the release binary
# (saves ~5 MiB).
# ---------------------------------------------------------------------
FROM rust:${RUST_VERSION}-${DEBIAN_VARIANT} AS builder
WORKDIR /app
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# Sprint D9 reproducibility hardening (cf.
# docs/bench/d9_deep_analysis_supplement.md §9).
#
#   * --remap-path-prefix erases the absolute build path
#     (`/app`) from .debug_info / panic backtraces. Without
#     this, two builds on different CI runners produce different
#     digests. The cost is zero (one rustc flag).
#
#   * `codegen-units=1` would also be desirable for bit-perfect
#     reproducibility, but it slows the build ~30% and the
#     remaining nondeterminism (rare in release builds with
#     LLVM ≥ 17) is caught by the nightly reproducibility job
#     (D9.A8). We accept the trade-off and document it.
#
#   * `--locked` (already present below) refuses to resolve
#     Cargo.lock — guarantees same dep set bit-for-bit.
ENV RUSTFLAGS="--remap-path-prefix /app=."
ENV CARGO_PROFILE_RELEASE_DEBUG=false

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev protobuf-compiler binutils python3 python3-dev \
    && rm -rf /var/lib/apt/lists/*
# Reuse the cacher's cargo cache + compiled deps.
COPY --from=cacher /app/target target
COPY --from=cacher /usr/local/cargo /usr/local/cargo
COPY . .
RUN cargo build --release --locked \
        --bin efe-server \
        --bin efe-backup \
        --bin efe-verify-audit \
        --bin efe-bundle \
    && strip target/release/efe-server \
    && strip target/release/efe-backup \
    && strip target/release/efe-verify-audit \
    && strip target/release/efe-bundle

# ---------------------------------------------------------------------
# Stage 4 : health-probe
#
# Fetch the grpc-health-probe static binary (~4 MiB). Shipping it inside
# the image means the kubelet can exec-probe gRPC without needing curl
# or any other shell tool inside the runtime layer.
# ---------------------------------------------------------------------
FROM alpine:3.20 AS health-probe
ARG GRPC_HEALTH_PROBE_VERSION
RUN apk add --no-cache curl ca-certificates \
    && curl --retry 3 --retry-delay 2 -fsSL \
        "https://github.com/grpc-ecosystem/grpc-health-probe/releases/download/${GRPC_HEALTH_PROBE_VERSION}/grpc_health_probe-linux-amd64" \
        -o /grpc_health_probe \
    && chmod 0755 /grpc_health_probe

# ---------------------------------------------------------------------
# Stage 5 : runtime (distroless-glibc, nonroot)
#
# The final image contains exactly two executables and nothing else:
#   /usr/local/bin/efe-server
#   /usr/local/bin/grpc_health_probe
#
# There is no /bin/sh, no apt, no libc debug symbols. Attack surface
# is reduced to the binary itself.
# ---------------------------------------------------------------------
FROM gcr.io/distroless/cc-debian12:nonroot AS runtime

LABEL org.opencontainers.image.source="https://github.com/efe-project/efe"
LABEL org.opencontainers.image.description="EFE gRPC server (MVP)"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.vendor="EFE Project"
LABEL org.opencontainers.image.documentation="https://github.com/efe-project/efe/blob/main/M12_ARCHITECTURE.md"

# distroless:nonroot already sets UID 65532. We override with 10001 to
# keep the UID stable across distroless upgrades and match the Helm
# chart's `podSecurityContext.runAsUser`.
USER 10001:10001
WORKDIR /

COPY --from=builder      --chown=10001:10001 /app/target/release/efe-server /usr/local/bin/efe-server
# Sprint D17 audit fix § AC1 : the efe-backup CLI MUST be in the
# runtime image so the backup CronJobs (Helm templates D17) can
# spawn it. Pre-audit, only efe-server was copied — backup pods
# would CrashLoop with "exec efe-backup: file not found".
# Same defect class as D16-C1 + D13bis-A20.
COPY --from=builder      --chown=10001:10001 /app/target/release/efe-backup /usr/local/bin/efe-backup
# Sprint D17 audit fix § AC4-bis : the DR drill verifiers
# (`AuditChainVerifier`, `BundleSignatureVerifier`) spawn these
# two binaries from the drill CronJob pod ; they MUST be in the
# image. Discovery from the workspace-wide pin test
# `test_workspace_dockerfile_coverage.py` follow-up.
COPY --from=builder      --chown=10001:10001 /app/target/release/efe-verify-audit /usr/local/bin/efe-verify-audit
COPY --from=builder      --chown=10001:10001 /app/target/release/efe-bundle      /usr/local/bin/efe-bundle
COPY --from=health-probe --chown=10001:10001 /grpc_health_probe            /usr/local/bin/grpc_health_probe

# Round-4 fix Cos6 : EXPOSE only declared gRPC + Prometheus pre-fix,
# but the Helm chart `charts/efe-stack/charts/efe-server/values.yaml`
# exports four ports : grpc 50051, metrics 9090, health 8081, agent
# REST 8088. EXPOSE is documentary (kubelet ignores it) but the drift
# misleads `docker inspect` consumers + IDE tools.
EXPOSE 50051 9090 8081 8088

ENV RUST_LOG="info,efe=info"
ENV EFE_LISTEN_ADDR="0.0.0.0:50051"
ENV EFE_METRICS_ADDR="0.0.0.0:9090"

# Distroless does not parse ENTRYPOINT through a shell — the binary is
# exec'd directly with argv[0] = the path below. This is exactly what
# we want in production (no shell interpolation of $VAR leaks).
ENTRYPOINT ["/usr/local/bin/efe-server"]

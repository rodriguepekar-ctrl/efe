# Development image: everything needed to build & test EFE.
FROM nvcr.io/nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:/root/.local/bin:${PATH}"
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates git build-essential cmake ninja-build pkg-config \
        python3.12 python3.12-venv python3.12-dev python3-pip \
        libssl-dev protobuf-compiler \
        clang-format \
    && rm -rf /var/lib/apt/lists/*

# Rust 1.88 toolchain (= workspace `rust-version = "1.88"` ; see
# Cargo.toml line 96 + ADR-D93-001). Originally 1.80, then 1.85.0,
# now 1.88 — Φ-D-OPS post-audit fix B2 unified all build surfaces.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain 1.88 \
        --component rustfmt clippy rust-src rust-analyzer
RUN cargo install --locked cargo-nextest cargo-audit taplo-cli

# uv (Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# just (command runner)
RUN curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh \
        | bash -s -- --to /usr/local/bin

# Verify toolchain
RUN rustc --version && cargo --version && python3.12 --version && just --version

WORKDIR /workspace
CMD ["bash"]

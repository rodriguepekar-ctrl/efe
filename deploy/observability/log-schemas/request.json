{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efe.example.com/schemas/log/v1.0/request.json",
  "title": "EFE request log stream (v1.0)",
  "description": "Sprint D13. One event per gRPC request. Emitted by the request_log interceptor.",
  "type": "object",
  "allOf": [
    { "$ref": "_common.json" },
    {
      "properties": {
        "stream": { "const": "request" }
      },
      "required": ["request_id", "rpc", "duration_ms", "status_code"]
    }
  ],
  "properties": {
    "rpc": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]+$",
      "description": "RPC method name (e.g. Classify, RegisterCatalog, ListCatalogs)."
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Wallclock duration of the RPC server-side, in milliseconds."
    },
    "status_code": {
      "type": "string",
      "enum": [
        "OK",
        "CANCELLED",
        "UNKNOWN",
        "INVALID_ARGUMENT",
        "DEADLINE_EXCEEDED",
        "NOT_FOUND",
        "ALREADY_EXISTS",
        "PERMISSION_DENIED",
        "RESOURCE_EXHAUSTED",
        "FAILED_PRECONDITION",
        "ABORTED",
        "OUT_OF_RANGE",
        "UNIMPLEMENTED",
        "INTERNAL",
        "UNAVAILABLE",
        "DATA_LOSS",
        "UNAUTHENTICATED"
      ],
      "description": "Canonical gRPC status code."
    },
    "client_ip": {
      "type": "string",
      "description": "Originating client IP. Honors X-Forwarded-For when behind a trusted proxy."
    },
    "user_agent": {
      "type": "string",
      "maxLength": 256,
      "description": "User-Agent header (truncated to 256 chars)."
    },
    "request_size_bytes": { "type": "integer", "minimum": 0 },
    "response_size_bytes": { "type": "integer", "minimum": 0 },
    "error_message": {
      "type": ["string", "null"],
      "maxLength": 1024,
      "description": "When status != OK, the gRPC error details (truncated)."
    }
  },
  "additionalProperties": true
}

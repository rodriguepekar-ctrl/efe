{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efe.example.com/schemas/log/v1.0/audit.json",
  "title": "EFE audit log stream (v1.0)",
  "description": "Sprint D13 — mirror of D12 § 13. One event per resource mutation (catalog or cone register/evolve/delete).",
  "type": "object",
  "allOf": [
    { "$ref": "_common.json" },
    {
      "properties": {
        "stream": { "const": "audit" }
      },
      "required": [
        "tenant_id",
        "principal",
        "action",
        "resource_type",
        "resource_key",
        "op_tag"
      ]
    }
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": ["register", "evolve", "delete"],
      "description": "High-level mutation kind."
    },
    "resource_type": {
      "type": "string",
      "enum": ["catalog", "cone"],
      "description": "Resource family. cone = M9-era ; catalog = D12+."
    },
    "resource_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*\\/[a-z][a-z0-9_-]*@v[0-9]+$",
      "description": "Canonical key tenant/name@vN."
    },
    "parent_key": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*\\/[a-z][a-z0-9_-]*@v[0-9]+$"
        },
        { "type": "string", "maxLength": 0 },
        { "type": "null" }
      ],
      "description": "Canonical key of the previous version (empty / null for register or delete)."
    },
    "op_tag": {
      "type": "string",
      "enum": [
        "register",
        "append_class",
        "remove_class",
        "update_thresholds",
        "replace_class_anchors",
        "recompile",
        "delete"
      ],
      "description": "Fine-grained operation tag. For register/delete, equal to action."
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{0,64}$",
      "description": "Hex digest of the content as committed (empty for delete)."
    },
    "description": {
      "type": "string",
      "maxLength": 1024,
      "description": "Free-text operator-supplied audit note."
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Free-form key-value labels stamped at register time."
    }
  },
  "additionalProperties": true
}

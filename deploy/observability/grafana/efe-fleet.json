{
  "title": "EFE — Fleet (pods, resources, SLI)",
  "tags": ["efe", "ops"],
  "uid": "efe-fleet",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      { "name": "prometheus", "type": "datasource", "query": "prometheus" },
      { "name": "pod", "type": "query", "datasource": "$prometheus",
        "query": "label_values(kube_pod_info{namespace=\"efe\",pod=~\"efe-server-.+\"}, pod)",
        "includeAll": true, "multi": true }
    ]
  },
  "panels": [
    {
      "title": "Pod count by state",
      "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "count(kube_pod_status_phase{namespace=\"efe\",phase=\"Running\",pod=~\"efe-server-.+\"})", "legendFormat": "Running" },
        { "refId": "B", "expr": "count(kube_pod_status_phase{namespace=\"efe\",phase=\"Pending\",pod=~\"efe-server-.+\"})", "legendFormat": "Pending" },
        { "refId": "C", "expr": "count(kube_pod_status_phase{namespace=\"efe\",phase=\"Failed\",pod=~\"efe-server-.+\"})", "legendFormat": "Failed" }
      ]
    },
    {
      "title": "HPA replicas (current / desired / min / max)",
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"efe\"}", "legendFormat": "current" },
        { "refId": "B", "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"efe\"}", "legendFormat": "desired" },
        { "refId": "C", "expr": "kube_horizontalpodautoscaler_spec_min_replicas{namespace=\"efe\"}", "legendFormat": "min" },
        { "refId": "D", "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"efe\"}", "legendFormat": "max" }
      ]
    },
    {
      "title": "CPU usage per pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "cores" } },
      "targets": [
        { "refId": "A", "expr": "rate(container_cpu_usage_seconds_total{namespace=\"efe\",pod=~\"$pod\",container=\"efe-server\"}[1m])", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "title": "Memory working set per pod",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "bytes" } },
      "targets": [
        { "refId": "A", "expr": "container_memory_working_set_bytes{namespace=\"efe\",pod=~\"$pod\",container=\"efe-server\"}", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "title": "Restart count (last 1h)",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 13 },
      "targets": [
        { "refId": "A", "expr": "increase(kube_pod_container_status_restarts_total{namespace=\"efe\",pod=~\"$pod\"}[1h])", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "title": "CPU throttling",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 13 },
      "targets": [
        { "refId": "A", "expr": "rate(container_cpu_cfs_throttled_seconds_total{namespace=\"efe\",pod=~\"$pod\"}[5m])", "legendFormat": "{{pod}}" }
      ]
    }
  ]
}

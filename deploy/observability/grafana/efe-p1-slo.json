{
  "title": "EFE — P1 SLO (Latence opposable)",
  "tags": ["efe", "p1", "slo", "latency"],
  "uid": "efe-p1-slo",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m"],
    "time_options": ["5m", "15m", "1h", "6h", "24h", "7d", "30d"]
  },
  "templating": {
    "list": [
      { "name": "prometheus", "type": "datasource", "query": "prometheus" }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "P1 status — SLO C-1 (p99 ≤ 200 ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "efe:p1_e2e_p99_seconds * 1000", "legendFormat": "p99 (ms)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 180 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "title": "P1 burn rate (1 h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "efe:p1_burn_rate:1h", "legendFormat": "burn × monthly" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "RPS effectif (Mode-1)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(efe_swarm_duration_seconds_count{mode=\"mode1\"}[1m]))", "legendFormat": "RPS" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 } }
    },
    {
      "id": 4,
      "title": "P1 p99.9 (SLO-P1-TAIL-1 ≤ 400 ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "efe:p1_e2e_p999_seconds * 1000", "legendFormat": "p99.9 (ms)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 350 },
              { "color": "red", "value": 400 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "P1 latency over time — p50 / p95 / p99 / p99.9",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "efe:p1_e2e_p50_seconds * 1000", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(efe_swarm_duration_seconds_bucket{mode=\"mode1\"}[5m]))) * 1000", "legendFormat": "p95" },
        { "refId": "C", "expr": "efe:p1_e2e_p99_seconds * 1000", "legendFormat": "p99" },
        { "refId": "D", "expr": "efe:p1_e2e_p999_seconds * 1000", "legendFormat": "p99.9" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 200 }
            ]
          },
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Per-stage p99 (12 étages — heatmap budget vs target)",
      "type": "bargauge",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A",  "expr": "efe:p1_stage_p99_seconds:grpc_recv * 1000",             "legendFormat": "1. grpc_recv (1.5 ms)" },
        { "refId": "B",  "expr": "efe:p1_stage_p99_seconds:grpc_decode * 1000",           "legendFormat": "2. grpc_decode (0.5 ms)" },
        { "refId": "C",  "expr": "efe:p1_stage_p99_seconds:interceptors * 1000",          "legendFormat": "3. interceptors (3 ms)" },
        { "refId": "D",  "expr": "efe:p1_stage_p99_seconds:tokenize * 1000",              "legendFormat": "4. tokenize (4 ms)" },
        { "refId": "E",  "expr": "efe:p1_stage_p99_seconds:embed_inference * 1000",       "legendFormat": "5. embed_inference (26 ms)" },
        { "refId": "F",  "expr": "efe:p1_stage_p99_seconds:genesis * 1000",               "legendFormat": "6. genesis (5 ms)" },
        { "refId": "G",  "expr": "efe:p1_stage_p99_seconds:fusion_round * 1000",          "legendFormat": "7. fusion (10 ms / round)" },
        { "refId": "H",  "expr": "efe:p1_stage_p99_seconds:consensus * 1000",             "legendFormat": "8. consensus (1 ms)" },
        { "refId": "I",  "expr": "efe:p1_stage_p99_seconds:dissolution_alignment * 1000", "legendFormat": "9. dissolution+align (6 ms)" },
        { "refId": "J",  "expr": "efe:p1_stage_p99_seconds:audit_chain_append * 1000",    "legendFormat": "10. audit_chain (4 ms)" },
        { "refId": "K",  "expr": "efe:p1_stage_p99_seconds:grpc_encode * 1000",           "legendFormat": "11. grpc_encode (1 ms)" },
        { "refId": "L",  "expr": "efe:p1_stage_p99_seconds:grpc_send * 1000",             "legendFormat": "12. grpc_send (1 ms)" }
      ],
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Stage overrun rate (5 min)",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "efe:p1_overrun_rate:5m * 100", "legendFormat": "{{ stage }}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "id": 8,
      "title": "Burn rates — multi-window",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "targets": [
        { "refId": "A", "expr": "efe:p1_burn_rate:1h",  "legendFormat": "1 h (page ≥ 14.4)" },
        { "refId": "B", "expr": "efe:p1_burn_rate:6h",  "legendFormat": "6 h (warn ≥ 6)" },
        { "refId": "C", "expr": "efe:p1_burn_rate:24h", "legendFormat": "24 h (ticket ≥ 1)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    },
    {
      "id": 9,
      "title": "Budget remaining at send (distribution)",
      "type": "heatmap",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "sum by (le) (increase(efe_p1_budget_remaining_seconds_bucket{mode=\"mode1\"}[1m]))", "format": "heatmap", "legendFormat": "{{le}}" }
      ],
      "options": {
        "yAxis": { "unit": "s" }
      }
    },
    {
      "id": 10,
      "title": "Top 10 slowest traces (last 15 min)",
      "type": "table",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "description": "Lien direct vers Tempo / Jaeger pour analyser les outliers p99.",
      "targets": [
        { "refId": "A", "datasource": { "type": "tempo" }, "queryType": "traceql",
          "query": "{ resource.service.name=\"efe-server\" && duration > 200ms } | select(span.tenant_id, span.budget_remaining_ms, span.swarm.agents_count) | sort -duration | limit 10" }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": { "type": "prometheus" },
        "enable": true,
        "expr": "changes(efe_build_info[1d]) > 0",
        "iconColor": "rgba(0, 211, 255, 1)",
        "tagKeys": "version"
      }
    ]
  }
}

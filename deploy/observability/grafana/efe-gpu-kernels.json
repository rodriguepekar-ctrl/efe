{
  "title": "EFE — GPU Kernels (Φ-D)",
  "tags": ["efe", "gpu", "cuda", "kernels", "phi-d"],
  "uid": "efe-gpu-kernels",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m"],
    "time_options": ["1h", "6h", "24h", "7d", "30d"]
  },
  "templating": {
    "list": [
      { "name": "prometheus", "type": "datasource", "query": "prometheus" },
      {
        "name": "device",
        "type": "query",
        "datasource": "$prometheus",
        "query": "label_values(efe_gpu_utilization_ratio, device)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Fusion round p99 (T4 fp16) — SLO-CUDA-FUSION-ROUND ≤ 10 ms",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe:gpu_fusion_round_p99_seconds * 1000",
          "legendFormat": "p99 (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 8 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Fusion total 10 rounds p99 — SLO-CUDA-FUSION-TOTAL ≤ 100 ms",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe:gpu_fusion_round_p99_seconds * 10 * 1000",
          "legendFormat": "p99 total (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 80 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Kernel failure rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe:gpu_kernel_failure_rate:5m * 100",
          "legendFormat": "% failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "OOM events / hour",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "efe:gpu_oom_per_hour", "legendFormat": "OOM/h" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "p99 par kernel (12 kernels)",
      "type": "bargauge",
      "gridPos": { "h": 12, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe:gpu_kernel_p99_seconds * 1000",
          "legendFormat": "{{ kernel }}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true }
    },
    {
      "id": 6,
      "title": "SM occupancy par device",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe_gpu_sm_occupancy_ratio",
          "legendFormat": "device {{ device }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.2 },
              { "color": "green", "value": 0.4 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "VRAM utilisation par device",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe_gpu_memory_used_bytes / 1024 / 1024 / 1024",
          "legendFormat": "device {{ device }} (GiB)"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "decgbytes", "decimals": 2 } }
    },
    {
      "id": 8,
      "title": "NCCL all-reduce p99",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe:gpu_nccl_allreduce_p99_seconds * 1000",
          "legendFormat": "p99 (ms)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Pinned host pool size",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe_gpu_pinned_host_pool_bytes / 1024 / 1024",
          "legendFormat": "MiB"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Driver/CUDA/Kernels SHA (active sur le fleet)",
      "type": "table",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 22 },
      "description": "Liste les combinaisons (driver, cuda_runtime, kernels_sha) actives. > 1 combo = rolling upgrade ou drift.",
      "targets": [
        {
          "refId": "A",
          "expr": "efe_gpu_driver_version_info",
          "format": "table",
          "instant": true
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": { "type": "prometheus" },
        "enable": true,
        "expr": "changes(efe_build_info[1d]) > 0",
        "iconColor": "rgba(0, 211, 255, 1)",
        "tagKeys": "version"
      }
    ]
  }
}

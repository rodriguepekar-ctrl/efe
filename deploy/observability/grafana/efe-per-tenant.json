{
  "title": "EFE — Per-Tenant",
  "tags": ["efe", "tenant"],
  "uid": "efe-per-tenant",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "prometheus", "type": "datasource", "query": "prometheus" },
      {
        "name": "tenant",
        "type": "query",
        "datasource": "$prometheus",
        "query": "label_values(efe_classify_requests_total, tenant)",
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "title": "Summary — tenant '$tenant'",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(efe_classify_requests_total{tenant=\"$tenant\"}[5m]))", "legendFormat": "QPS" },
        { "refId": "B", "expr": "sum(rate(efe_classify_errors_total{tenant=\"$tenant\"}[5m])) / sum(rate(efe_classify_requests_total{tenant=\"$tenant\"}[5m]))", "legendFormat": "Error rate" },
        { "refId": "C", "expr": "histogram_quantile(0.95, sum by (le) (rate(efe_classify_duration_seconds_bucket{tenant=\"$tenant\"}[5m])))", "legendFormat": "p95" }
      ]
    },
    {
      "title": "Quota utilisation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(efe_classify_requests_total{tenant=\"$tenant\"}[1m])) / on() (efe_tenant_quota_qps{tenant=\"$tenant\"})"
        }
      ]
    },
    {
      "title": "Rate-limited requests (RESOURCE_EXHAUSTED)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(efe_classify_errors_total{tenant=\"$tenant\",grpc_code=\"RESOURCE_EXHAUSTED\"}[5m]))" }
      ]
    },
    {
      "title": "Label distribution (this tenant)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum by (label) (rate(efe_classify_requests_total{tenant=\"$tenant\"}[1h]))", "legendFormat": "{{label}}" }
      ]
    },
    {
      "title": "Monthly cost projection (chargeback)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(efe_classify_requests_total{tenant=\"$tenant\"}[30d])) * 0.00001)",
          "legendFormat": "projected $/30d"
        }
      ]
    }
  ]
}

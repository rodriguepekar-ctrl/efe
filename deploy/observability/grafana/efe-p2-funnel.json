{
  "title": "EFE — P2 Self-service Funnel",
  "tags": ["efe", "p2", "self-service", "activation", "funnel"],
  "uid": "efe-p2-funnel",
  "schemaVersion": 38,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["30s", "1m", "5m", "15m", "1h"],
    "time_options": ["1h", "6h", "24h", "7d", "30d", "90d"]
  },
  "templating": {
    "list": [
      { "name": "prometheus", "type": "datasource", "query": "prometheus" },
      {
        "name": "plan_target",
        "type": "query",
        "datasource": "$prometheus",
        "query": "label_values(efe_p2_funnel_started_total, plan_target)",
        "includeAll": false,
        "current": { "value": "poc", "text": "poc" }
      },
      {
        "name": "cloud",
        "type": "query",
        "datasource": "$prometheus",
        "query": "label_values(efe_p2_funnel_t_to_first_classify_seconds_count, cloud)",
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "T-T-First-Classify p90 — $plan_target",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe:p2_ttfc_p90_seconds{plan_target=\"$plan_target\"} / 60",
          "legendFormat": "p90 (min)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 25 },
              { "color": "red", "value": 30 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "values": false, "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Burn rate (1 h)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "efe:p2_burn_rate:1h", "legendFormat": "burn × monthly" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active sessions (in-flight)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (plan_target) (efe_p2_funnel_active_sessions)",
          "legendFormat": "{{ plan_target }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "id": 4,
      "title": "Conversion sandbox → POC (90 j)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "efe:p2_conversion_sandbox_to_poc:90d * 100", "legendFormat": "conv %" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 5 },
              { "color": "green", "value": 10 }
            ]
          }
        }
      }
    },

    {
      "id": 5,
      "title": "Funnel waterfall — abandons par étape",
      "description": "Sessions ayant atteint chaque étape, normalisées au start.",
      "type": "bargauge",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 4 },
      "targets": [
        { "refId": "A", "expr": "1 - efe:p2_abandon_rate_by_step:1h",
          "legendFormat": "{{ step }}", "instant": true }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.70 },
              { "color": "green", "value": 0.90 }
            ]
          }
        }
      },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "showUnfilled": true }
    },

    {
      "id": 6,
      "title": "Provisioning p99 — par cloud × layer",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe:p2_provisioning_p99_seconds / 60",
          "legendFormat": "{{ cloud }} / {{ layer }}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "m", "decimals": 1 } }
    },
    {
      "id": 7,
      "title": "Cloud parity — p90 par cloud",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "refId": "A",
          "expr": "efe:p2_ttfc_p90_by_cloud:1h / 60",
          "legendFormat": "{{ cloud }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 30 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    },

    {
      "id": 8,
      "title": "Top error_class (drops, 24 h)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (reason) (increase(efe_p2_funnel_drop_total[24h])))",
          "legendFormat": "{{ reason }}",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "title": "Quickstart language popularity",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (language) (increase(efe_p2_funnel_quickstart_choice_total[24h]))",
          "legendFormat": "{{ language }}",
          "instant": true
        }
      ]
    },

    {
      "id": 10,
      "title": "Multi-window burn rates",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "targets": [
        { "refId": "A", "expr": "efe:p2_burn_rate:1h",  "legendFormat": "1 h (page ≥ 14.4)" },
        { "refId": "B", "expr": "efe:p2_burn_rate:6h",  "legendFormat": "6 h (warn ≥ 6)" },
        { "refId": "C", "expr": "efe:p2_burn_rate:24h", "legendFormat": "24 h (ticket ≥ 1)" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red", "value": 14.4 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "datasource": { "type": "prometheus" },
        "enable": true,
        "expr": "changes(efe_build_info[1d]) > 0",
        "iconColor": "rgba(0, 211, 255, 1)",
        "tagKeys": "version"
      }
    ]
  }
}

{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.2.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0"}
  ],
  "uid": "efe-d13-01-operator-overview",
  "title": "EFE — 01 Operator Overview",
  "description": "Sprint D13 — golden-signals dashboard for SRE on-call. Latency p99, error rate, throughput, saturation, top noisy tenants. Source : architecture D13 § 9.1.",
  "tags": ["efe", "d13", "operator", "sre"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "timepicker": {"refresh_intervals": ["10s", "30s", "1m", "5m", "15m"]},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "name": "Alerts",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{family=\"D13-OBS\", alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "textFormat": "Tenant {{tenant}} severity {{severity}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"},
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "loki_datasource",
        "type": "datasource",
        "query": "loki",
        "current": {"text": "Loki", "value": "Loki"},
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "tenant",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "query": "label_values(efe_grpc_requests_total, tenant)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"},
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "rpc",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "query": "label_values(efe_grpc_requests_total, method)",
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"},
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Row 0 — SLO compliance heatmap",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1},
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 2,
      "title": "SLO compliance",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 1, "w": 24, "h": 3},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red",   "value": null},
              {"color": "orange","value": 0.95},
              {"color": "green", "value": 0.99}
            ]
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(rate(efe_grpc_requests_total{code!=\"OK\"}[5m])) / sum(rate(efe_grpc_requests_total[5m])))",
          "legendFormat": "Global success ratio (5m)"
        }
      ]
    },
    {
      "type": "row",
      "id": 3,
      "title": "Row 1 — Golden signals",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 1},
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Latency p99 (1m)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 5, "w": 6, "h": 4},
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red",    "value": 1.0}
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(efe_grpc_request_duration_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Error rate (5m)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 6, "y": 5, "w": 6, "h": 4},
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red",    "value": 0.05}
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(efe_grpc_requests_total{code!=\"OK\"}[5m])) / sum(rate(efe_grpc_requests_total[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Throughput (RPS)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 12, "y": 5, "w": 6, "h": 4},
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(efe_grpc_requests_total[1m]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Saturation (CPU)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 18, "y": 5, "w": 6, "h": 4},
      "options": {"colorMode": "value", "graphMode": "area"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 0.8},
              {"color": "red",    "value": 0.9}
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(rate(container_cpu_usage_seconds_total{namespace=~\"efe.*|tenant-.+\"}[5m])) / on() group_left() max(kube_pod_container_resource_limits{resource=\"cpu\", namespace=~\"efe.*|tenant-.+\"})"
        }
      ]
    },
    {
      "type": "row",
      "id": 8,
      "title": "Row 2 — Latency distribution & exemplars",
      "gridPos": {"x": 0, "y": 9, "w": 24, "h": 1}
    },
    {
      "type": "heatmap",
      "id": 9,
      "title": "Latency heatmap (with trace exemplars)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 10, "w": 16, "h": 8},
      "options": {
        "calculate": false,
        "yAxis": {"unit": "s", "min": 0, "scale": "log"},
        "color": {"scheme": "Spectral", "mode": "scheme"},
        "exemplars": {"color": "rgba(255,0,0,1)"}
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(efe_grpc_request_duration_seconds_bucket{tenant=~\"$tenant\", method=~\"$rpc\"}[5m])) by (le)",
          "legendFormat": "{{le}}",
          "format": "heatmap",
          "exemplar": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Error rate per RPC (stacked)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 16, "y": 10, "w": 8, "h": 8},
      "options": {"legend": {"showLegend": true, "displayMode": "table"}, "tooltip": {"mode": "multi"}},
      "fieldConfig": {
        "defaults": {
          "custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}, "fillOpacity": 80}
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(efe_grpc_requests_total{code!=\"OK\", tenant=~\"$tenant\", method=~\"$rpc\"}[5m]))",
          "legendFormat": "{{code}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 11,
      "title": "Row 3 — Tenant breakdown",
      "gridPos": {"x": 0, "y": 18, "w": 24, "h": 1}
    },
    {
      "type": "table",
      "id": 12,
      "title": "Top 5 noisy tenants (error rate × RPS)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 19, "w": 12, "h": 8},
      "options": {"showHeader": true},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, efe:rpc_error_rate:5m)",
          "legendFormat": "{{tenant}}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {"tenant": 0, "Value": 1},
            "renameByName": {"Value": "Error rate"}
          }
        }
      ]
    },
    {
      "type": "alertlist",
      "id": 13,
      "title": "Active D13 alerts",
      "gridPos": {"x": 12, "y": 19, "w": 12, "h": 8},
      "options": {
        "showOptions": "current",
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "tags": ["efe", "d13"],
        "stateFilter": {"firing": true, "pending": true, "noData": false, "normal": false}
      }
    },
    {
      "type": "row",
      "id": 14,
      "title": "Row 4 — Recent errors (Loki tail)",
      "gridPos": {"x": 0, "y": 27, "w": 24, "h": 1}
    },
    {
      "type": "logs",
      "id": 15,
      "title": "Recent errors — last 5 min",
      "datasource": {"type": "loki", "uid": "$loki_datasource"},
      "gridPos": {"x": 0, "y": 28, "w": 24, "h": 10},
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "$loki_datasource"},
          "expr": "{stream=\"request\", level=\"ERROR\", tenant_id=~\"$tenant\"} | json"
        }
      ]
    }
  ],
  "links": [
    {"title": "Tenant drill-down",        "url": "/d/efe-d13-02-tenant-drill-down",        "type": "dashboards"},
    {"title": "Catalog versions",         "url": "/d/efe-d13-03-catalog-version-distribution", "type": "dashboards"},
    {"title": "Capacity planning",        "url": "/d/efe-d13-06-capacity-planning",         "type": "dashboards"},
    {"title": "Runbooks",                  "url": "https://docs.efe.ai/runbooks/",           "targetBlank": true}
  ]
}

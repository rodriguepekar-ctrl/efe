{
  "annotations": { "list": [] },
  "description": "M32 — Vector Search operator overview.",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Search rate by mode (1m)",
      "targets": [
        {
          "expr": "sum by(mode) (rate(efe_vector_search_total[1m]))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Search p99 latency by mode",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by(mode, le) (rate(efe_vector_search_duration_ms_bucket[5m])))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Collection cardinality (top 10)",
      "targets": [
        {
          "expr": "topk(10, efe_vector_collection_size)",
          "legendFormat": "{{collection}}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 4,
      "type": "stat",

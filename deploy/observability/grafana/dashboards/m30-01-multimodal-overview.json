{
  "annotations": { "list": [] },
  "description": "M30 — Multi-modal + Multi-region operator overview.",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Multimodal E2E p99 latency by modality",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by(modality, le) (rate(efe_multimodal_e2e_duration_ms_bucket[5m])))",
          "legendFormat": "{{modality}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Multimodal request rate by modality + outcome",
      "targets": [
        {
          "expr": "sum by(modality, outcome) (rate(efe_multimodal_requests_total[1m]))",
          "legendFormat": "{{modality}} / {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Triton inference p99 by model",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by(model_name, le) (rate(efe_multimodal_triton_duration_ms_bucket[5m])))",
          "legendFormat": "{{model_name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Cross-region peer up + replication lag",
      "targets": [
        {
          "expr": "efe_region_peer_up",
          "legendFormat": "peer_up {{region}}",
          "refId": "A"
        },
        {
          "expr": "efe_region_replication_lag_secs",
          "legendFormat": "lag {{slot_name}}",
          "refId": "B"
        }
      ],
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "In-flight multimodal requests",
      "targets": [
        {
          "expr": "sum by(modality) (efe_multimodal_inflight)",
          "legendFormat": "{{modality}}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Triton transport errors (1m rate)",
      "targets": [
        {
          "expr": "sum by(kind) (rate(efe_multimodal_triton_errors_total[1m]))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Failover events (24h)",
      "targets": [
        {
          "expr": "sum(increase(efe_region_failover_total[24h]))",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 4 }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Input guard rejections (1h)",
      "targets": [
        {
          "expr": "sum by(reason) (increase(efe_multimodal_rejections_total[1h]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 4 }
    }
  ],
  "refresh": "30s",

{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.2.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"},
    {"type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0"}
  ],
  "uid": "efe-d13-03-catalog-version-distribution",
  "title": "EFE — 03 Catalog Version Distribution",
  "description": "Sprint D13 — catalog curator view : version chains, age distribution, evolve op rate, recent audit events. Source : architecture D13 § 9.3.",
  "tags": ["efe", "d13", "catalog", "curator"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {"from": "now-7d", "to": "now"},
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"}
      },
      {
        "name": "loki_datasource",
        "type": "datasource",
        "query": "loki",
        "current": {"text": "Loki", "value": "Loki"}
      },
      {
        "name": "tenant",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "query": "label_values(efe_catalog_versions_per_name, tenant)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "catalog_name",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "query": "label_values(efe_catalog_versions_per_name{tenant=~\"$tenant\"}, name)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Chain depth & age",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}
    },
    {
      "type": "table",
      "id": 2,
      "title": "Version chain depth (tenant × catalog)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 1, "w": 24, "h": 8},
      "options": {"showHeader": true, "cellHeight": "sm"},
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {"type": "color-background", "mode": "gradient"}
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 50},
              {"color": "orange", "value": 100},
              {"color": "red",    "value": 200}
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "efe:catalog_chain_depth:1m{tenant=~\"$tenant\", name=~\"$catalog_name\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {"tenant": 0, "name": 1, "Value": 2},
            "renameByName": {"Value": "Versions"}
          }
        }
      ]
    },
    {
      "type": "row",
      "id": 3,
      "title": "Evolution patterns",
      "gridPos": {"x": 0, "y": 9, "w": 24, "h": 1}
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Evolve op rate (stacked by op_tag)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 10, "w": 16, "h": 8},
      "options": {"legend": {"showLegend": true, "displayMode": "table"}},
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 60}
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (op_tag) (efe:catalog_evolve_rate:5m{tenant=~\"$tenant\"})",
          "legendFormat": "{{op_tag}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Average chain depth",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 16, "y": 10, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {
          "refId": "A",
          "expr": "avg(efe_catalog_versions_per_name{tenant=~\"$tenant\"})"
        }
      ]
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Total catalogs",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 20, "y": 10, "w": 4, "h": 4},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {
          "refId": "A",
          "expr": "count(efe_catalog_versions_per_name{tenant=~\"$tenant\"})"
        }
      ]
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Recompiles 7d",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 16, "y": 14, "w": 4, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 10}
            ]
          }
        }
      },
      "options": {"colorMode": "background"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(efe_audit_events_total{tenant=~\"$tenant\", op_tag=\"recompile\"}[7d]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 8,
      "title": "Removes 7d",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 20, "y": 14, "w": 4, "h": 4},
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green",  "value": null},
              {"color": "yellow", "value": 5}
            ]
          }
        }
      },
      "options": {"colorMode": "background"},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(efe_audit_events_total{tenant=~\"$tenant\", op_tag=\"remove_class\"}[7d]))"
        }
      ]
    },
    {
      "type": "row",
      "id": 9,
      "title": "Audit event tail (Loki)",
      "gridPos": {"x": 0, "y": 18, "w": 24, "h": 1}
    },
    {
      "type": "logs",
      "id": 10,
      "title": "Recent evolution events",
      "datasource": {"type": "loki", "uid": "$loki_datasource"},
      "gridPos": {"x": 0, "y": 19, "w": 24, "h": 12},
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{stream=\"evolution\", tenant_id=~\"$tenant\"} | json"
        }
      ]
    }
  ],
  "links": [
    {"title": "Operator Overview",  "url": "/d/efe-d13-01-operator-overview",        "type": "dashboards"},
    {"title": "Tenant Drill-Down",  "url": "/d/efe-d13-02-tenant-drill-down",        "type": "dashboards"},
    {"title": "Audit stream",       "url": "/d/efe-d13-05-audit-stream",             "type": "dashboards"}
  ]
}

{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.2.0"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "uid": "efe-d13-04-cost-attribution",
  "title": "EFE — 04 Cost Attribution",
  "description": "Sprint D13 — finance / FinOps view : per-tenant CPU minutes, RAM GB-hours, requests, anchors compiled, reconciliation with aggregate_usage.py D11. Source : architecture D13 § 9.4.",
  "tags": ["efe", "d13", "cost", "finance", "finops"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {"from": "now/M", "to": "now"},
  "timepicker": {"refresh_intervals": ["5m", "15m", "1h", "6h"]},
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "Prometheus"}
      },
      {
        "name": "tenant",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "$datasource"},
        "query": "label_values(efe:cpu_minutes_per_tenant:1h, namespace)",
        "includeAll": true,
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Top spenders",
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}
    },
    {
      "type": "bargauge",
      "id": 2,
      "title": "Top 10 tenants by CPU minutes (MTD)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 1, "w": 12, "h": 8},
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {"defaults": {"unit": "m"}},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (namespace) (sum_over_time(efe:cpu_minutes_per_tenant:1h[$__range])))",
          "legendFormat": "{{namespace}}",
          "instant": true
        }
      ]
    },
    {
      "type": "bargauge",
      "id": 3,
      "title": "Top 10 tenants by RAM GB-hours (MTD)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 12, "y": 1, "w": 12, "h": 8},
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "fieldConfig": {"defaults": {"unit": "decgbytes"}},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (namespace) (sum_over_time(efe:ram_gb_hours_per_tenant:1h[$__range])))",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "id": 4,
      "title": "Cost trend over the window",
      "gridPos": {"x": 0, "y": 9, "w": 24, "h": 1}
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "CPU minutes by top-5 tenants (hourly)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 10, "w": 24, "h": 8},
      "options": {"legend": {"showLegend": true, "displayMode": "table"}},
      "fieldConfig": {"defaults": {"unit": "m"}},
      "targets": [
        {
          "refId": "A",
          "expr": "topk(5, efe:cpu_minutes_per_tenant:1h)",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 6,
      "title": "Cost composition",
      "gridPos": {"x": 0, "y": 18, "w": 24, "h": 1}
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Total CPU minutes (MTD)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 19, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "m"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(efe:cpu_minutes_per_tenant:1h[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 8,
      "title": "Total RAM GB-hours (MTD)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 6, "y": 19, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "decgbytes"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum_over_time(efe:ram_gb_hours_per_tenant:1h[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 9,
      "title": "Total requests (MTD)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 12, "y": 19, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(efe_grpc_requests_total[$__range]))"
        }
      ]
    },
    {
      "type": "stat",
      "id": 10,
      "title": "Anchors compiled (MTD)",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 18, "y": 19, "w": 6, "h": 4},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(efe_compile_anchors_seconds_count[$__range]))"
        }
      ]
    },
    {
      "type": "row",
      "id": 11,
      "title": "Reconciliation with aggregate_usage.py",
      "gridPos": {"x": 0, "y": 23, "w": 24, "h": 1}
    },
    {
      "type": "table",
      "id": 12,
      "title": "Per-tenant raw breakdown",
      "datasource": {"type": "prometheus", "uid": "$datasource"},
      "gridPos": {"x": 0, "y": 24, "w": 24, "h": 10},
      "options": {"showHeader": true},
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "cpu_min"},
            "properties": [{"id": "unit", "value": "m"}]
          },
          {
            "matcher": {"id": "byName", "options": "ram_gbh"},
            "properties": [{"id": "unit", "value": "decgbytes"}]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (sum_over_time(efe:cpu_minutes_per_tenant:1h[$__range]))",
          "legendFormat": "cpu_min",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (namespace) (sum_over_time(efe:ram_gb_hours_per_tenant:1h[$__range]))",
          "legendFormat": "ram_gbh",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ]
    }
  ],
  "links": [
    {"title": "Operator Overview",  "url": "/d/efe-d13-01-operator-overview", "type": "dashboards"},
    {"title": "Tenant Drill-Down",  "url": "/d/efe-d13-02-tenant-drill-down", "type": "dashboards"},
    {"title": "aggregate_usage.py", "url": "https://docs.efe.ai/howto/cost-attribution", "targetBlank": true}
  ]
}

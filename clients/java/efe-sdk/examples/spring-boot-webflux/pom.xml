<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.2</version>
    <relativePath/>
  </parent>

  <groupId>ai.efe.examples</groupId>
  <artifactId>efe-sdk-example-spring-boot-webflux</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>EFE SDK Example — Spring Boot WebFlux</name>
  <description>Sprint D26 (Φ-B) — Reactive Spring WebFlux + Mono.fromFuture(client.classifyAsync) example.</description>

  <properties>
    <java.version>17</java.version>
    <efe-sdk.version>0.4.0</efe-sdk.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.efe</groupId>
      <artifactId>efe-sdk-java</artifactId>
      <version>${efe-sdk.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webflux</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

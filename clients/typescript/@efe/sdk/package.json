{
  "name": "@efe/sdk",
  "version": "0.3.0",
  "description": "Official TypeScript SDK for EFE — isomorphic Node + Browser, type-safe end-to-end. Sprint D24 (Φ-B) v0.3.0 private; v1.0.0 GA public.",
  "license": "Apache-2.0",
  "author": "EFE team <oss@efe-ai.com>",
  "homepage": "https://github.com/efe-ai/efe",
  "repository": {
    "type": "git",
    "url": "https://github.com/efe-ai/efe.git",
    "directory": "clients/typescript/@efe/sdk"
  },
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/web/index.d.ts",
        "import": "./dist/web/index.js"
      },
      "node": {
        "types": "./dist/node/index.d.ts",
        "import": "./dist/node/index.js",
        "require": "./dist/node/index.cjs"
      },
      "default": {
        "types": "./dist/web/index.d.ts",
        "import": "./dist/web/index.js"
      }
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.cjs"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "import": "./dist/mock/index.js",
      "require": "./dist/mock/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check src tests",
    "lint:fix": "biome check --apply src tests",
    "gen:proto": "./scripts/gen-proto.sh",
    "bundlesize": "node scripts/bundlesize.mjs",
    "publish:dry": "pnpm build && npm publish --dry-run --access=restricted",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.1.0",
    "@connectrpc/connect": "^1.4.0",
    "@connectrpc/connect-node": "^1.4.0",
    "@connectrpc/connect-web": "^1.4.0"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.10.0",
    "@opentelemetry/api": "^1.9.0",
    "prom-client": "^15.1.0"
  },
  "peerDependenciesMeta": {
    "@grpc/grpc-js": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "prom-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@bufbuild/protoc-gen-es": "^2.1.0",
    "@connectrpc/protoc-gen-connect-es": "^1.4.0",
    "@grpc/grpc-js": "^1.14.3",
    "@opentelemetry/api": "^1.9.0",
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.0",
    "gzip-size": "^7.0.0",
    "prom-client": "^15.1.0",
    "tsup": "^8.2.0",
    "typedoc": "^0.26.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
